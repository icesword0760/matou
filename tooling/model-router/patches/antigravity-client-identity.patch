+	var sigAlgs []utls.SignatureScheme
+	var keyShares []utls.KeyShare
+	for _, extension := range spec.Extensions {
+		switch value := extension.(type) {
+		case *utls.ALPNExtension:
+			alpn = value.AlpnProtocols
+		case *utls.SupportedCurvesExtension:
+			groups = value.Curves
+		case *utls.SignatureAlgorithmsExtension:
+			sigAlgs = value.SupportedSignatureAlgorithms
+		case *utls.KeyShareExtension:
+			keyShares = value.KeyShares
+		}
+	}
+	if strings.Join(alpn, ",") != "h2,http/1.1" {
+		t.Fatalf("ALPN = %v, want h2,http/1.1", alpn)
+	}
+	wantGroups := []utls.CurveID{4588, 4587, 4589, 29, 23, 24, 25}
+	if len(groups) != len(wantGroups) {
+		t.Fatalf("groups = %v, want %v", groups, wantGroups)
+	}
+	for index, group := range wantGroups {
+		if groups[index] != group {
