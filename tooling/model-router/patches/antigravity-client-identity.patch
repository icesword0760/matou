@@ -0,0 +1,42 @@
+package codextls
+
+import (
+	"testing"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+func TestCodexClientHelloMatchesNativeCapture(t *testing.T) {
+	spec := ClientHelloSpec()
+	if len(spec.CipherSuites) != 22 || spec.CipherSuites[0] != 0x00ff {
+		t.Fatalf("cipher suites = %v, want the captured 22-entry list starting with 0x00ff", spec.CipherSuites)
+	}
+	var curves []utls.CurveID
+	var sigAlgs []utls.SignatureScheme
+	hasALPN := false
+	hasSupportedVersions := false
+	hasKeyShare := false
+	for _, extension := range spec.Extensions {
+		switch value := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = value.Curves
+		case *utls.SignatureAlgorithmsExtension:
+			sigAlgs = value.SupportedSignatureAlgorithms
+		case *utls.ALPNExtension:
+			hasALPN = true
+		case *utls.SupportedVersionsExtension:
+			hasSupportedVersions = true
+		case *utls.KeyShareExtension:
+			hasKeyShare = true
+		}
+	}
+	if len(curves) != 3 || curves[0] != utls.CurveP256 || curves[2] != utls.CurveP521 {
+		t.Fatalf("curves = %v, want P-256/P-384/P-521", curves)
+	}
+	if len(sigAlgs) != 8 || sigAlgs[0] != 0x0401 || sigAlgs[1] != 0x0201 {
+		t.Fatalf("signature algorithms = %x, want the captured 8-entry list", sigAlgs)
+	}
+	if hasALPN || hasSupportedVersions || hasKeyShare {
+		t.Fatal("native Codex ClientHello has no ALPN, supported_versions or key share")
+	}
+}
