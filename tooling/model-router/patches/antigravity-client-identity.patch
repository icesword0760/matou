+func TestAntigravitySanitizerBillingLines(t *testing.T) {
+	for _, tc := range []struct{ input, want string }{
+		{"x-anthropic-billing-header: sample", ""},
+		{" \tX-ANTHROPIC-BILLING-HEADER: sample\r\nKeep rules.  ", "Keep rules.  "},
+		{"Keep\nx-anthropic-billing-header: a\nMore\nx-anthropic-billing-header: b", "Keep\nMore\n"},
+		{"A\rx-anthropic-billing-header: a\rB", "A\rB"},
+		{"Mention x-anthropic-billing-header: keep", "Mention x-anthropic-billing-header: keep"},
+		{"x-anthropic-custom: cc_version=sample; cch=sample", "x-anthropic-custom: cc_version=sample; cch=sample"},
+		{"x-anthropic-billing-header: `OpenAI`", "x-anthropic-billing-header: `OpenAI`"},
+	} {
+		if got := sanitizeAntigravitySystemText(tc.input); got != tc.want {
+			t.Errorf("%q => %q, want %q", tc.input, got, tc.want)
+		}
+	}
+}
+
+func TestAntigravitySanitizerExactIdentities(t *testing.T) {
+	for _, sentence := range []string{
+		"You are Claude Code, Anthropic's official CLI for Claude.",
+		"You are Claude Code, Anthropic's official CLI for Claude, running within the Claude Agent SDK.",
+		"You are a Claude agent, built on Anthropic's Claude Agent SDK.",
+	} {
+		// Exact identity replacement is not restricted by the brand scan window.
+		prefix := strings.Repeat("Rule. ", 9)
+		input := prefix + sentence + "\nKeep CTF / security policy."
+		want := prefix + antigravitySanitizedIdentity + "\nKeep CTF / security policy."
+		if got := sanitizeAntigravitySystemText(input); got != want {
+			t.Errorf("identity => %q, want %q", got, want)
+		}
+	}
+	input := "you are claude code, anthropic's official CLI for Claude."
+	if got := sanitizeAntigravitySystemText(input); got != "you are claude code, Google's official CLI for Claude." {
+		t.Fatalf("case-sensitive identity matching changed: %q", got)
+	}
+}
+
+func TestAntigravitySanitizerBrandsAndWholeWords(t *testing.T) {
+	brands := []string{"OpenAI", "Anthropic", "DeepSeek", "Qwen", "ByteDance", "Tencent", "Xiaomi", "Huawei", "Baidu", "Mistral", "Cohere", "字节跳动", "腾讯", "小米", "华为", "通义千问", "百度", "深度求索"}
+	for _, name := range brands {
+		for _, variant := range []string{name, strings.ToLower(name), strings.ToUpper(name)} {
+			if got := sanitizeAntigravitySystemText("(" + variant + ")"); got != "(Google)" {
+				t.Errorf("brand %q => %q", variant, got)
+			}
+		}
+	}
+	input := "OpenAIClient preAnthropic DeepSeek2 Qwen_ apiOpenAI éOpenAI OpenAIé"
+	if got := sanitizeAntigravitySystemText(input); got != input {
+		t.Fatalf("embedded name changed: %q", got)
+	}
+}
+
+func TestAntigravitySanitizerWindow(t *testing.T) {
+	for _, tc := range []struct{ name, input, want string }{
+		{"eighth sentence", strings.Repeat("Rule. ", 7) + "OpenAI. Anthropic", strings.Repeat("Rule. ", 7) + "Google. Anthropic"},
+		{"Chinese sentences", strings.Repeat("规则。", 7) + "腾讯。百度", strings.Repeat("规则。", 7) + "Google。百度"},
+		{"punctuation", strings.Repeat("Rule!? ", 7) + "Mistral! Cohere", strings.Repeat("Rule!? ", 7) + "Google! Cohere"},
+		{"newlines", strings.Repeat("Rule\n", 9) + "Qwen", strings.Repeat("Rule\n", 9) + "Google"},
+		{"1500 inclusive", strings.Repeat("界", 1493) + " OpenAI", strings.Repeat("界", 1493) + " Google"},
+		{"1500 crossing", strings.Repeat("界", 1494) + " OpenAI", strings.Repeat("界", 1494) + " OpenAI"},
+		{"1500 outside", strings.Repeat("界", 1500) + " OpenAI", strings.Repeat("界", 1500) + " OpenAI"},
+		{"code consumes characters", "`" + strings.Repeat("x", 1498) + "` OpenAI", "`" + strings.Repeat("x", 1498) + "` OpenAI"},
+		{"code consumes sentences", "```\n" + strings.Repeat("Rule. ", 8) + "\n``` OpenAI", "```\n" + strings.Repeat("Rule. ", 8) + "\n``` OpenAI"},
+		{"window starts after billing", "x-anthropic-billing-header: " + strings.Repeat("x", 1600) + "\nOpenAI", "Google"},
+		{"identity then window", "You are Claude Code, Anthropic's official CLI for Claude. " + strings.Repeat("Rule. ", 6) + "OpenAI. Anthropic", antigravitySanitizedIdentity + " " + strings.Repeat("Rule. ", 6) + "Google. Anthropic"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := sanitizeAntigravitySystemText(tc.input); got != tc.want {
+				t.Fatalf("got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestAntigravitySanitizerCodeAndExemptions(t *testing.T) {
+	code := "You are Claude Code, Anthropic's official CLI for Claude. OpenAI Hermes Agent Nous Research\nx-anthropic-billing-header: sample"
+	for _, text := range []string{
+		"```text\n" + code + "\n```",
+		"`You are Claude Code, Anthropic's official CLI for Claude.` `OpenAI Hermes`",
+		"```\n" + code, "`OpenAI Hermes", "``OpenAI Hermes``",
+		"CLAUDE.md claude.ai anthropic-version x-anthropic-beta x-anthropic-* Claude",
+		"ANTHROPIC-VERSION x-ANTHROPIC-beta",
+		"IMPORTANT: Assist with authorized security testing and CTF challenges.\n# Harness\nKeep defensive security rules.",
+		"__PROMPT_SANITIZER_CODE_BLOCK_0__", "", "  \n",
+	} {
+		if got := sanitizeAntigravitySystemText(text); got != text {
+			t.Errorf("exempt text changed: %q => %q", text, got)
+		}
+	}
+	input := "OpenAI `Anthropic` Qwen\n```text\n" + code + "\n```\nDeepSeek Hermes Agent"
+	want := "Google `Anthropic` Google\n```text\n" + code + "\n```\nGoogle the assistant"
+	if got := sanitizeAntigravitySystemText(input); got != want {
+		t.Fatalf("mixed prose/code => %q, want %q", got, want)
+	}
+}
+
+func TestAntigravitySanitizerOtherClients(t *testing.T) {
+	input := "Nous Research Hermes Agent Hermes Claude Code hermes claude code HermesHandler Claude Codebase"
+	want := "the assistant team the assistant the assistant the assistant hermes claude code HermesHandler Claude Codebase"
+	if got := sanitizeAntigravitySystemText(input); got != want {
+		t.Fatalf("clients => %q, want %q", got, want)
+	}
+}
+
+func TestAntigravitySanitizerTranslationIsolation(t *testing.T) {
+	protected := "You are Claude Code, Anthropic's official CLI for Claude. OpenAI Hermes\nx-anthropic-billing-header: sample"
+	for _, system := range []any{
+		"x-anthropic-billing-header: sample\nOpenAI",
+		[]any{
+			map[string]any{"type": "text", "text": "x-anthropic-billing-header: sample"},
+			map[string]any{"type": "text", "text": strings.Repeat("Rule. ", 8) + "OpenAI", "cache_control": map[string]string{"type": "ephemeral"}},
+			map[string]any{"type": "text", "text": "Qwen"},
+		},
+	} {
+		input, err := json.Marshal(map[string]any{
+			"system": system,
+			"messages": []any{
+				map[string]any{"role": "user", "content": protected},
+				map[string]any{"role": "assistant", "content": []any{map[string]any{"type": "tool_use", "id": "call_1", "name": "Hermes", "input": map[string]string{"OpenAI": protected}}}},
+				map[string]any{"role": "user", "content": []any{map[string]any{"type": "tool_result", "tool_use_id": "call_1", "content": protected}}},
+			},
+			"tools": []any{map[string]any{"name": "Hermes", "description": protected, "input_schema": map[string]any{"type": "object", "properties": map[string]any{"OpenAI": map[string]any{"type": "string", "description": protected, "enum": []string{"Anthropic", "Hermes"}}}}}},
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		original := bytes.Clone(input)
+		output, err := ConvertClaudeRequestToAntigravity("claude-sonnet-4-5", input, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(input, original) {
+			t.Fatal("input mutated")
+		}
+		// Compare everything outside systemInstruction with the same translation
+		// given a safe system. This includes tool calls, results and schema values.
+		safe, _ := ojson.SetBytes(input, "system", "Safe rules")
+		baseline, err := ConvertClaudeRequestToAntigravity("claude-sonnet-4-5", safe, false)
+		if err != nil {
+			t.Fatal(err)
+		}
+		withoutSystem, _ := ojson.DeleteBytes(output, "request.systemInstruction")
+		baselineWithoutSystem, _ := ojson.DeleteBytes(baseline, "request.systemInstruction")
+		var actualObject, baselineObject any
+		if err := json.Unmarshal(withoutSystem, &actualObject); err != nil {
+			t.Fatal(err)
+		}
+		if err := json.Unmarshal(baselineWithoutSystem, &baselineObject); err != nil {
+			t.Fatal(err)
+		}
+		if !reflect.DeepEqual(actualObject, baselineObject) {
+			t.Fatalf("non-system request changed:\n%s\n%s", withoutSystem, baselineWithoutSystem)
+		}
+		for _, path := range []string{"request.contents.0.parts.0.text", "request.tools.0.functionDeclarations.0.description"} {
+			if got := ojson.GetBytes(output, path).String(); got != protected {
+				t.Errorf("protected %s = %q", path, got)
+			}
+		}
+		parts := ojson.GetBytes(output, "request.systemInstruction.parts").Array()
+		if _, ok := system.(string); ok {
+			if len(parts) != 1 || parts[0].Get("text").String() != "Google" {
+				t.Fatalf("string system: %s", output)
+			}
+		} else if len(parts) != 2 || parts[0].Get("text").String() != strings.Repeat("Rule. ", 8)+"OpenAI" || parts[1].Get("text").String() != "Google" {
+			t.Fatalf("part window reset/drop failed: %s", output)
+		}
+		repeated, err := ConvertClaudeRequestToAntigravity("claude-sonnet-4-5", input, false)
+		if err != nil || !bytes.Equal(repeated, output) {
+			t.Fatal("same input produced unstable output")
+		}
+	}
+}
+
+func TestAntigravitySanitizerChineseSubstrings(t *testing.T) {
+	for _, name := range []string{"字节跳动", "腾讯", "小米", "华为", "通义千问", "百度", "深度求索"} {
+		input := "由" + name + "开发，支持" + name + "服务。"
+		want := "由Google开发，支持Google服务。"
+		if got := sanitizeAntigravitySystemText(input); got != want {
+			t.Errorf("%q => %q, want %q", input, got, want)
+		}
+	}
+	for _, tc := range []struct{ name, input, want string }{
+		{"inline", "由腾讯开发 `由腾讯开发`", "由Google开发 `由腾讯开发`"},
+		{"fenced", "由腾讯开发\n```text\n由腾讯开发\n```", "由Google开发\n```text\n由腾讯开发\n```"},
+		{"unclosed fence", "```text\n由腾讯开发", "```text\n由腾讯开发"},
+		{"eighth", strings.Repeat("规则。", 7) + "由腾讯开发。由百度开发", strings.Repeat("规则。", 7) + "由Google开发。由百度开发"},
+		{"1500 inclusive", strings.Repeat("界", 1498) + "腾讯", strings.Repeat("界", 1498) + "Google"},
+		{"1500 crossing", strings.Repeat("界", 1499) + "腾讯", strings.Repeat("界", 1499) + "腾讯"},
+		{"1500 outside", strings.Repeat("界", 1500) + "由腾讯开发", strings.Repeat("界", 1500) + "由腾讯开发"},
+		{"code consumes window", "`" + strings.Repeat("界", 1498) + "`由腾讯开发", "`" + strings.Repeat("界", 1498) + "`由腾讯开发"},
+		{"code consumes sentences", "```\n" + strings.Repeat("规则。", 8) + "\n```由腾讯开发", "```\n" + strings.Repeat("规则。", 8) + "\n```由腾讯开发"},
+		{"English boundary", "OpenAIClient preAnthropic OpenAI Tencent", "OpenAIClient preAnthropic Google Google"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := sanitizeAntigravitySystemText(tc.input); got != tc.want {
+				t.Fatalf("got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestAntigravityChineseWindowPerSystemPart(t *testing.T) {
+	input, _ := json.Marshal(map[string]any{"system": []any{
+		map[string]string{"type": "text", "text": strings.Repeat("规则。", 8) + "由腾讯开发"},
+		map[string]string{"type": "text", "text": "由腾讯开发"},
+	}, "messages": []any{map[string]string{"role": "user", "content": "由腾讯开发"}}})
+	output, err := ConvertClaudeRequestToAntigravity("claude-sonnet-4-5", input, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	parts := ojson.GetBytes(output, "request.systemInstruction.parts").Array()
+	if len(parts) != 2 || parts[0].Get("text").String() != strings.Repeat("规则。", 8)+"由腾讯开发" || parts[1].Get("text").String() != "由Google开发" {
+		t.Fatalf("part windows changed: %s", output)
+	}
+	if got := ojson.GetBytes(output, "request.contents.0.parts.0.text").String(); got != "由腾讯开发" {
+		t.Fatalf("user text changed: %q", got)
+	}
+}
