@@ -0,0 +1,244 @@
+package codextls
+
+import (
+	"bufio"
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"reflect"
+	"testing"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+)
+
+func TestCodexClientHelloMatchesNativeCapture(t *testing.T) {
+	spec := ClientHelloSpec()
+	if len(spec.CipherSuites) != 22 || spec.CipherSuites[0] != 0x00ff {
+		t.Fatalf("cipher suites = %v, want the captured 22-entry list starting with 0x00ff", spec.CipherSuites)
+	}
+	var curves []utls.CurveID
+	var sigAlgs []utls.SignatureScheme
+	hasALPN := false
+	hasSupportedVersions := false
+	hasKeyShare := false
+	for _, extension := range spec.Extensions {
+		switch value := extension.(type) {
+		case *utls.SupportedCurvesExtension:
+			curves = value.Curves
+		case *utls.SignatureAlgorithmsExtension:
+			sigAlgs = value.SupportedSignatureAlgorithms
+		case *utls.ALPNExtension:
+			hasALPN = true
+		case *utls.SupportedVersionsExtension:
+			hasSupportedVersions = true
+		case *utls.KeyShareExtension:
+			hasKeyShare = true
+		}
+	}
+	if len(curves) != 3 || curves[0] != utls.CurveP256 || curves[2] != utls.CurveP521 {
+		t.Fatalf("curves = %v, want P-256/P-384/P-521", curves)
+	}
+	if len(sigAlgs) != 8 || sigAlgs[0] != 0x0401 || sigAlgs[1] != 0x0201 {
+		t.Fatalf("signature algorithms = %x, want the captured 8-entry list", sigAlgs)
+	}
+	if hasALPN || hasSupportedVersions || hasKeyShare {
+		t.Fatal("native Codex ClientHello has no ALPN, supported_versions or key share")
+	}
+}
+
+// Capture the actual first target TLS record, after a real loopback CONNECT.
+// The peer closes after ClientHello; a successful remote handshake is not needed
+// to distinguish the native profile from net/http's default crypto/tls profile.
+func TestCodexClientHelloThroughHTTPConnect(t *testing.T) {
+	for _, authenticated := range []bool{false, true} {
+		t.Run(map[bool]string{false: "anonymous", true: "authenticated"}[authenticated], func(t *testing.T) {
+			type capture struct {
+				request *http.Request
+				record  []byte
+				err     error
+			}
+			captured := make(chan capture, 1)
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				conn, rw, err := w.(http.Hijacker).Hijack()
+				if err != nil {
+					captured <- capture{err: err}
+					return
+				}
+				defer conn.Close()
+				_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+				_, err = io.WriteString(conn, "HTTP/1.1 200 Connection Established\r\n\r\n")
+				if err != nil {
+					captured <- capture{err: err}
+					return
+				}
+				header := make([]byte, 5)
+				_, err = io.ReadFull(rw, header)
+				if err != nil {
+					captured <- capture{err: err}
+					return
+				}
+				body := make([]byte, int(binary.BigEndian.Uint16(header[3:])))
+				_, err = io.ReadFull(rw, body)
+				captured <- capture{r, append(header, body...), err}
+			}))
+			defer server.Close()
+			proxyURL := server.URL
+			if authenticated {
+				proxyURL = "http://audit:fixture@" + server.Listener.Addr().String()
+			}
+			tr := newRoundTripper(proxyURL, time.Second)
+			defer tr.CloseIdleConnections()
+			_, err := (&http.Client{Transport: tr, Timeout: 3 * time.Second}).Get("https://codex-target.test/capture")
+			if err == nil {
+				t.Fatal("capture peer closes before ServerHello; expected handshake error")
+			}
+			var got capture
+			select {
+			case got = <-captured:
+			case <-time.After(4 * time.Second):
+				t.Fatal("no target ClientHello captured")
+			}
+			if got.err != nil {
+				t.Fatal(got.err)
+			}
+			if got.request.Method != "CONNECT" || got.request.Host != "codex-target.test:443" {
+				t.Fatalf("proxy request = %s %s", got.request.Method, got.request.Host)
+			}
+			wantAuth := ""
+			if authenticated {
+				wantAuth = "Basic YXVkaXQ6Zml4dHVyZQ=="
+			}
+			if got.request.Header.Get("Proxy-Authorization") != wantAuth {
+				t.Fatal("CONNECT authentication changed")
+			}
+			record := got.record
+			if len(record) < 44 || record[0] != 22 || record[5] != 1 {
+				t.Fatalf("not a ClientHello record: %x", record)
+			}
+			body := record[5:]
+			i := 4 + 2 + 32
+			i += 1 + int(body[i])
+			n := int(binary.BigEndian.Uint16(body[i:]))
+			i += 2
+			var ciphers, extensions []uint16
+			for end := i + n; i < end; i += 2 {
+				ciphers = append(ciphers, binary.BigEndian.Uint16(body[i:]))
+			}
+			i += 1 + int(body[i])
+			n = int(binary.BigEndian.Uint16(body[i:]))
+			i += 2
+			for end := i + n; i < end; {
+				extensions = append(extensions, binary.BigEndian.Uint16(body[i:]))
+				i += 4 + int(binary.BigEndian.Uint16(body[i+2:]))
+			}
+			if !reflect.DeepEqual(ciphers, ClientHelloSpec().CipherSuites) {
+				t.Fatalf("target ciphers = %x, want native %x", ciphers, ClientHelloSpec().CipherSuites)
+			}
+			if want := []uint16{0, 10, 11, 13, 5, 18, 23}; !reflect.DeepEqual(extensions, want) {
+				t.Fatalf("target extensions = %v, want %v", extensions, want)
+			}
+			t.Logf("CONNECT %s: ciphers=%x extensions=%v", got.request.Host, ciphers, extensions)
+		})
+	}
+}
+
+func TestCodexHTTPConnectFailureDoesNotBypassProxy(t *testing.T) {
+	target := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("request bypassed rejected proxy") }))
+	defer target.Close()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusProxyAuthRequired) }))
+	defer server.Close()
+	tr := newRoundTripper(server.URL, time.Second)
+	defer tr.CloseIdleConnections()
+	_, err := (&http.Client{Transport: tr, Timeout: 2 * time.Second}).Get(target.URL)
+	if err == nil {
+		t.Fatal("rejected CONNECT must fail instead of dialing target directly")
+	}
+}
+
+func TestCodexHTTPConnectCancellation(t *testing.T) {
+	entered := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		close(entered)
+		// No CONNECT response. Read returns once the canceled dial closes its socket.
+		_, _ = rw.ReadByte()
+	}))
+	defer server.Close()
+	tr := newRoundTripper(server.URL, time.Second)
+	defer tr.CloseIdleConnections()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	req, _ := http.NewRequestWithContext(ctx, "GET", "https://codex-target.test/capture", nil)
+	done := make(chan error, 1)
+	go func() { _, err := (&http.Client{Transport: tr}).Do(req); done <- err }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("CONNECT did not start")
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("cancellation = %v", err)
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("canceled CONNECT did not return")
+	}
+}
+
+func TestCodexHTTPConnectPlainHTTPAndPooling(t *testing.T) {
+	// Plain HTTP must also use the resolved dialer after removing Transport.Proxy.
+	connects := make(chan string, 2)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, rw, err := w.(http.Hijacker).Hijack()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		_ = conn.SetDeadline(time.Now().Add(3 * time.Second))
+		connects <- r.Method + " " + r.Host
+		_, _ = rw.WriteString("HTTP/1.1 200 Connection Established\r\n\r\n")
+		_ = rw.Flush()
+		reader := bufio.NewReader(rw)
+		for i := 0; i < 2; i++ {
+			req, err := http.ReadRequest(reader)
+			if err != nil {
+				return
+			}
+			req.Body.Close()
+			_, _ = rw.WriteString("HTTP/1.1 200 OK\r\nContent-Length: 2\r\n\r\nok")
+			_ = rw.Flush()
+		}
+	}))
+	defer server.Close()
+	tr := newRoundTripper(server.URL, time.Second)
+	defer tr.CloseIdleConnections()
+	client := &http.Client{Transport: tr, Timeout: 3 * time.Second}
+	for i := 0; i < 2; i++ {
+		resp, err := client.Get("http://codex-target.test/capture")
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, err := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		if err != nil || string(body) != "ok" {
+			t.Fatalf("response=%q err=%v", body, err)
+		}
+	}
+	if len(connects) != 1 {
+		t.Fatalf("CONNECT count=%d, want one pooled tunnel", len(connects))
+	}
+	if got := <-connects; got != "CONNECT codex-target.test:80" {
+		t.Fatalf("proxy request=%q", got)
+	}
+}
