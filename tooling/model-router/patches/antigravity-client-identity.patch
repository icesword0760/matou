diff --git a/internal/codextls/codextls.go b/internal/codextls/codextls.go
new file mode 100644
index 0000000..591dd5d
--- /dev/null
+++ b/internal/codextls/codextls.go
@@ -0,0 +1,145 @@
+// Package codextls reproduces the TLS identity of the native Codex CLI for
+// ChatGPT traffic.
+//
+// The installed Codex CLI 0.162.1 (Rust) sends a TLS 1.2 ClientHello with no
+// ALPN and no supported_versions extension: SNI, supported groups P-256/P-384/
+// P-521, one point format, RSA/ECDSA signature algorithms including SHA-1,
+// OCSP status_request, SCT and extended_master_secret, in that order. It then
+// uses HTTP/1.1 and reuses connections.
+//
+// The spec below is a byte-structured copy of a capture from that binary. It
+// intentionally differs from the Chrome uTLS profile the upstream router used:
+// the native client is not a browser, and the probe and inference paths must
+// present the same identity for one ChatGPT token.
+package codextls
+
+import (
+	"context"
+	"crypto/tls"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+	log "github.com/sirupsen/logrus"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cache"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+	"golang.org/x/net/proxy"
+)
+
+// ClientHelloSpec returns the captured Codex 0.162.1 ClientHello.
+func ClientHelloSpec() *utls.ClientHelloSpec {
+	return &utls.ClientHelloSpec{
+		CipherSuites: []uint16{
+			0x00ff, 0xc02c, 0xc02b, 0xc024, 0xc023, 0xc00a, 0xc009, 0xc008,
+			0xc030, 0xc02f, 0xc028, 0xc027, 0xc014, 0xc013, 0xc012,
+			0x009d, 0x009c, 0x003d, 0x003c, 0x0035, 0x002f, 0x000a,
+		},
+		CompressionMethods: []uint8{0},
+		Extensions: []utls.TLSExtension{
+			&utls.SNIExtension{},
+			&utls.SupportedCurvesExtension{Curves: []utls.CurveID{utls.CurveP256, utls.CurveP384, utls.CurveP521}},
+			&utls.SupportedPointsExtension{SupportedPoints: []byte{0}},
+			&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				0x0401, 0x0201, 0x0501, 0x0601, 0x0403, 0x0203, 0x0503, 0x0603,
+			}},
+			&utls.StatusRequestExtension{},
+			&utls.SCTExtension{},
+			&utls.UtlsExtendedMasterSecretExtension{},
+		},
+		// No SupportedVersionsExtension, ALPNExtension or KeyShareExtension:
+		// the native client caps at TLS 1.2 and uses HTTP/1.1.
+	}
+}
+
+type roundTripperKey struct {
+	scope   string
+	proxy   string
+	timeout time.Duration
+}
+
+const roundTripperCacheCapacity = 8192
+
+var roundTrippers = cache.NewBoundedLRU[roundTripperKey, *http.Transport](
+	roundTripperCacheCapacity,
+	func(_ roundTripperKey, transport *http.Transport) {
+		if transport != nil {
+			transport.CloseIdleConnections()
+		}
+	},
+)
+
+// RoundTripper returns a pooled HTTP/1.1 transport with the native Codex TLS
+// identity. scope isolates one credential's pool; proxyURL is the resolved
+// router proxy ("" means direct); timeout bounds only the TLS handshake.
+func RoundTripper(scope, proxyURL string, timeout time.Duration) http.RoundTripper {
+	key := roundTripperKey{scope: strings.TrimSpace(scope), proxy: strings.TrimSpace(proxyURL), timeout: timeout}
+	return roundTrippers.GetOrAdd(key, func() *http.Transport {
+		return newRoundTripper(key.proxy, timeout)
+	})
+}
+
+func newRoundTripper(proxyURL string, timeout time.Duration) *http.Transport {
+	var dialer proxy.Dialer = proxy.Direct
+	if proxyURL != "" {
+		proxyDialer, mode, errBuild := proxyutil.BuildDialer(proxyURL)
+		if errBuild != nil {
+			log.Errorf("codex tls: failed to configure proxy dialer for %q: %v", proxyutil.Redact(proxyURL), errBuild)
+		} else if mode != proxyutil.ModeInherit && proxyDialer != nil {
+			dialer = proxyDialer
+		}
+	}
+
+	transport := &http.Transport{
+		// No ALPN, so the native client stays on HTTP/1.1; pooling is explicit.
+		ForceAttemptHTTP2:   false,
+		MaxIdleConnsPerHost: 2,
+		IdleConnTimeout:     90 * time.Second,
+		DialTLSContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			host, _, errSplit := net.SplitHostPort(addr)
+			if errSplit != nil {
+				return nil, fmt.Errorf("codex tls: split upstream address: %w", errSplit)
+			}
+			conn, errDial := dialContext(ctx, dialer, network, addr)
+			if errDial != nil {
+				return nil, fmt.Errorf("codex tls: dial upstream: %w", errDial)
+			}
+			tlsConn := utls.UClient(conn, &utls.Config{ServerName: host, MaxVersion: tls.VersionTLS12}, utls.HelloCustom)
+			if errPreset := tlsConn.ApplyPreset(ClientHelloSpec()); errPreset != nil {
+				_ = tlsConn.Close()
+				return nil, fmt.Errorf("codex tls: apply ClientHello: %w", errPreset)
+			}
+			handshakeCtx, cancelHandshake := handshakeContext(ctx, timeout)
+			defer cancelHandshake()
+			if errHandshake := tlsConn.HandshakeContext(handshakeCtx); errHandshake != nil {
+				_ = tlsConn.Close()
+				return nil, fmt.Errorf("codex tls: TLS handshake: %w", errHandshake)
+			}
+			return tlsConn, nil
+		},
+	}
+	// Keep the conventional Proxy view for callers that inspect it. The dial
+	// path above already routed through proxyutil for HTTP and SOCKS proxies.
+	if parsed, errParse := url.Parse(proxyURL); proxyURL != "" && errParse == nil && (parsed.Scheme == "http" || parsed.Scheme == "https") {
+		transport.Proxy = http.ProxyURL(parsed)
+	}
+	return transport
+}
+
+func dialContext(ctx context.Context, dialer proxy.Dialer, network, addr string) (net.Conn, error) {
+	if contextDialer, ok := dialer.(proxy.ContextDialer); ok {
+		return contextDialer.DialContext(ctx, network, addr)
+	}
+	return dialer.Dial(network, addr)
+}
+
+func handshakeContext(ctx context.Context, timeout time.Duration) (context.Context, context.CancelFunc) {
+	if timeout <= 0 {
+		return ctx, func() {}
+	}
+	return context.WithTimeout(ctx, timeout)
+}
+
