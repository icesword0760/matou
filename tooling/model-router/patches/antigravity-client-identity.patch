+// CoalesceGeminiBackgroundNotificationParts merges adjacent compacted
+// background-task notification text parts inside the same Gemini user turn
+// into one <system-reminder> part. Generic reminders, user text, images, and
+// functionResponse parts are preserved untouched.
+func CoalesceGeminiBackgroundNotificationParts(parts [][]byte) [][]byte {
+	if len(parts) <= 1 {
+		return parts
+	}
+	out := make([][]byte, 0, len(parts))
+	var pendingBodies []string
+	flush := func() {
+		if len(pendingBodies) == 0 {
+			return
+		}
+		partJSON, _ := ojson.SetBytes([]byte(`{}`), "text", BuildGeminiBackgroundNotificationText(strings.Join(pendingBodies, "\n\n")))
+		out = append(out, partJSON)
+		pendingBodies = nil
+	}
+	for _, p := range parts {
+		if isPureGeminiTextPart(p) {
+			if body, ok := ExtractGeminiBackgroundNotificationBody(ojson.GetBytesNoCopy(p, "text").String()); ok {
+				pendingBodies = append(pendingBodies, body)
+				continue
+			}
+		}
+		flush()
+		out = append(out, p)
+	}
+	flush()
+	return out
+}
+
+func isPureGeminiTextPart(part []byte) bool {
+	if !ojson.GetBytesNoCopy(part, "text").Exists() {
+		return false
+	}
+	for _, key := range []string{"functionResponse", "function_response", "functionCall", "function_call", "inlineData", "inline_data", "thoughtSignature", "thought"} {
+		if ojson.GetBytesNoCopy(part, key).Exists() {
+			return false
+		}
+	}
+	return true
+}
