+				{"200 lines inclusive", "`opening\n" + strings.Repeat("line\n", 198) + line + "`", "`opening\n" + strings.Repeat("line\n", 198) + line + "`"},
+				{"201 lines falls back", "`opening\n" + strings.Repeat("line\n", 199) + line + "`", "`opening\n" + strings.Repeat("line\n", 199) + clean + "`"},
+				{"different run cannot close", "``opening\n" + line + "```", "``opening\n" + clean + "```"},
+				{"fence after unmatched inline", "`opening\n```text\n" + line + "\n```\n" + line, "`opening\n```text\n" + line + "\n```\n" + clean},
