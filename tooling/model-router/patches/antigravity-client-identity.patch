+// codexTransportScope keeps one Codex connection pool per credential.
+func codexTransportScope(auth *cliproxyauth.Auth) string {
+	if auth == nil {
+		return "anonymous"
+	}
+	if scope := strings.TrimSpace(auth.Index); scope != "" {
+		return scope
+	}
+	if scope := strings.TrimSpace(auth.ID); scope != "" {
+		return scope
+	}
+	return "anonymous"
