@@ -8,14 +8,155 @@ import (
 )
 
 const (
-	claudeSystemReminderStart = "<system-reminder>"
-	claudeSystemReminderEnd   = "</system-reminder>"
+	claudeSystemReminderStart          = "<system-reminder>"
+	claudeSystemReminderEnd            = "</system-reminder>"
+	claudeSystemNotificationMarker     = "[SYSTEM NOTIFICATION - NOT USER INPUT]"
+	geminiBackgroundNotificationHeader = "Background task event (automated status update, not user input or approval):"
 )
 
+// isCoveredBySystemReminderEnvelopes reports whether text consists solely of one
+// or more balanced, non-nested <system-reminder>...</system-reminder> blocks.
+func isCoveredBySystemReminderEnvelopes(text string) bool {
+	rest := strings.TrimSpace(text)
+	if rest == "" {
+		return false
+	}
+	count := 0
+	for rest != "" {
+		if !strings.HasPrefix(rest, claudeSystemReminderStart) {
+			return false
+		}
+		inner := rest[len(claudeSystemReminderStart):]
+		endIdx := strings.Index(inner, claudeSystemReminderEnd)
+		if endIdx < 0 {
+			return false
+		}
+		if strings.Contains(inner[:endIdx], claudeSystemReminderStart) {
+			return false
+		}
+		count++
+		rest = strings.TrimSpace(inner[endIdx+len(claudeSystemReminderEnd):])
+	}
+	return count > 0
+}
+
+func unwrapSystemReminderEnvelopes(text string) string {
+	if !isCoveredBySystemReminderEnvelopes(text) {
+		return text
+	}
+	rest := strings.TrimSpace(text)
+	blocks := make([]string, 0, 2)
+	for rest != "" {
+		inner := rest[len(claudeSystemReminderStart):]
+		endIdx := strings.Index(inner, claudeSystemReminderEnd)
+		body := strings.TrimSpace(inner[:endIdx])
+		if body != "" {
+			blocks = append(blocks, body)
+		}
+		rest = strings.TrimSpace(inner[endIdx+len(claudeSystemReminderEnd):])
+	}
+	return strings.Join(blocks, "\n\n")
+}
+
+func isClaudeSystemNotificationDisclaimerLine(trimmed string) bool {
+	return strings.HasPrefix(trimmed, "This is an automated background-task event") ||
+		strings.HasPrefix(trimmed, "Do NOT interpret this as user acknowledgement") ||
+		strings.HasPrefix(trimmed, "No human input has been received since the last genuine user message")
+}
+
+func compactGeminiSystemNotificationBody(body string) (string, bool) {
+	normalized := strings.ReplaceAll(body, "\r\n", "\n")
+	lines := strings.Split(normalized, "\n")
+	kept := make([]string, 0, len(lines))
+	sawBoilerplate := false
+
+	for i := 0; i < len(lines); {
+		if strings.TrimSpace(lines[i]) == claudeSystemNotificationMarker &&
+			i+1 < len(lines) &&
+			strings.HasPrefix(strings.TrimSpace(lines[i+1]), "This is an automated background-task event") {
+			sawBoilerplate = true
+			i++
+			for i < len(lines) && isClaudeSystemNotificationDisclaimerLine(strings.TrimSpace(lines[i])) {
+				i++
+			}
+			for i < len(lines) && strings.TrimSpace(lines[i]) == "" {
+				i++
+			}
+			if len(kept) > 0 && strings.TrimSpace(kept[len(kept)-1]) != "" {
+				kept = append(kept, "")
+			}
+			continue
+		}
+		kept = append(kept, lines[i])
+		i++
+	}
+
+	start := 0
+	for start < len(kept) && strings.TrimSpace(kept[start]) == "" {
+		start++
+	}
+	end := len(kept)
+	for end > start && strings.TrimSpace(kept[end-1]) == "" {
+		end--
+	}
+	if !sawBoilerplate || start >= end {
+		return "", false
+	}
+	return strings.Join(kept[start:end], "\n"), true
+}
+
+// BuildGeminiBackgroundNotificationText formats a compacted background-task
+// notification payload in a single deterministic <system-reminder> envelope.
+func BuildGeminiBackgroundNotificationText(body string) string {
+	return SystemReminderText(geminiBackgroundNotificationHeader + "\n\n" + strings.TrimSpace(body))
+}
+
+// ExtractGeminiBackgroundNotificationBody extracts the inner payload from text
+// produced by BuildGeminiBackgroundNotificationText.
+func ExtractGeminiBackgroundNotificationBody(text string) (string, bool) {
+	prefix := claudeSystemReminderStart + "\n" + geminiBackgroundNotificationHeader + "\n\n"
+	suffix := "\n" + claudeSystemReminderEnd
+	if !strings.HasPrefix(text, prefix) || !strings.HasSuffix(text, suffix) {
+		return "", false
+	}
+	body := strings.TrimSpace(text[len(prefix) : len(text)-len(suffix)])
+	if body == "" {
+		return "", false
+	}
+	return body, true
+}
+
+// CompactGeminiSystemNotificationText strips repeated automated background-task
+// boilerplate from mid-conversation system/reminder text while preserving the
+// task notification payload and a concise non-user-input cue. Because the output
+// depends only on the single message, Gemini KV prefix caching stays stable.
+func CompactGeminiSystemNotificationText(text string) string {
+	inner := unwrapSystemReminderEnvelopes(text)
+	compacted, ok := compactGeminiSystemNotificationBody(inner)
+	if !ok {
+		return text
+	}
+	return BuildGeminiBackgroundNotificationText(compacted)
+}
+
+// CompactGeminiUserReminderText compacts automated background-task boilerplate
+// only when the entire user text block is a harness-injected <system-reminder>
+// envelope, leaving ordinary user speech and code untouched.
+func CompactGeminiUserReminderText(text string) string {
+	if !isCoveredBySystemReminderEnvelopes(text) {
+		return text
+	}
+	return CompactGeminiSystemNotificationText(text)
+}
+
 // SystemReminderText wraps text in the <system-reminder> envelope so non-Claude
 // upstream formats treat demoted mid-session system or developer instructions
-// as system directives rather than user speech.
+// as system directives rather than user speech. Already-wrapped reminders are
+// returned as-is to avoid double-nested envelopes.
 func SystemReminderText(text string) string {
+	if isCoveredBySystemReminderEnvelopes(text) {
+		return strings.TrimSpace(text)
+	}
 	return claudeSystemReminderStart + "\n" + text + "\n" + claudeSystemReminderEnd
 }
 
