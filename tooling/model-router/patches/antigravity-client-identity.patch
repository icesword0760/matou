+++ b/internal/util/claude_system_identity.go
@@ -0,0 +1,141 @@
+package util
+
+import (
+	"strings"
+	"unicode"
+)
+
+var claudeCodeSystemIdentityReplacer = strings.NewReplacer(
+	"You are Claude Code, Anthropic's official CLI for Claude.", "You are a coding assistant.",
+	"You are Claude Code, Anthropic's official CLI for Claude, running within the Claude Agent SDK.", "You are a coding assistant.",
+	"You are a Claude agent, built on Anthropic's Claude Agent SDK.", "You are a coding agent.",
+)
+
+// NeutralizeClaudeCodeSystemIdentity replaces only the three complete, case-sensitive
+// client identity sentences. Callers must restrict its use to system instructions.
+// All other bytes, including whitespace and project guidance, are preserved.
+func NeutralizeClaudeCodeSystemIdentity(text string) string {
+	return MapSystemTextProse(text, claudeCodeSystemIdentityReplacer.Replace)
+}
+
+// StripLeadingClaudeCodeBillingLines removes only leading billing lines, preserving
+// the rest of a system part byte-for-byte. It never scans or removes later prose.
+func StripLeadingClaudeCodeBillingLines(text string) string {
+	for IsClaudeCodeAttributionSystemText(text) {
+		line := strings.TrimLeftFunc(text, unicode.IsSpace)
+		end := strings.IndexAny(line, "\r\n")
+		if end < 0 {
+			return ""
+		}
+		next := end + 1
+		if line[end] == '\r' && next < len(line) && line[next] == '\n' {
+			next++
+		}
+		text = line[next:]
+	}
+	return text
+}
+
+// Backtick spans are copied verbatim, without placeholder strings. Fences
+// start at an indented line boundary and close only on a standalone run at least
+// as long as the opener. Inline spans close on an exact run within 200 lines;
+// if unmatched, only the rest of the opening line is protected.
+func SystemTextCodeMask(text string) []bool {
+	mask := make([]bool, len(text))
+	lineStart := 0
+	for i := 0; i < len(text); {
+		if text[i] != '`' {
+			if text[i] == '\r' || text[i] == '\n' {
+				lineStart = i + 1
+			}
+			i++
+			continue
+		}
+		width := 1
+		for i+width < len(text) && text[i+width] == '`' {
+			width++
+		}
+		end := len(text)
+		if width >= 3 && strings.TrimSpace(text[lineStart:i]) == "" {
+			// Skip the complete opening line, including its info string.
+			for search := i + width; search < len(text); {
+				newline := strings.IndexAny(text[search:], "\r\n")
+				if newline < 0 {
+					break
+				}
+				start := search + newline + 1
+				if text[start-1] == '\r' && start < len(text) && text[start] == '\n' {
+					start++
+				}
+				lineEnd := len(text)
+				if newline := strings.IndexAny(text[start:], "\r\n"); newline >= 0 {
+					lineEnd = start + newline
+				}
+				line := strings.TrimSpace(text[start:lineEnd])
+				if len(line) >= width && strings.Trim(line, "`") == "" {
+					end = lineEnd
+					break
+				}
+				search = lineEnd
+			}
+		} else {
+			// Preserve the existing conservative fallback for unmatched inline code.
+			if newline := strings.IndexAny(text[i+width:], "\r\n"); newline >= 0 {
+				end = i + width + newline
+			}
+			lines := 1
+			for search := i + width; search < len(text); {
+				if text[search] == '\r' || text[search] == '\n' {
+					lines++
+					if lines > 200 {
+						break
+					}
+					if text[search] == '\r' && search+1 < len(text) && text[search+1] == '\n' {
+						search++
+					}
+					search++
+					continue
+				}
+				if text[search] != '`' {
+					search++
+					continue
+				}
+				closeEnd := search + 1
+				for closeEnd < len(text) && text[closeEnd] == '`' {
+					closeEnd++
+				}
+				if closeEnd-search == width {
+					end = closeEnd
+					break
+				}
+				search = closeEnd
+			}
+		}
+		for j := i; j < end; j++ {
+			mask[j] = true
+		}
+		if newline := strings.LastIndexAny(text[i:end], "\r\n"); newline >= 0 {
+			lineStart = i + newline + 1
+		}
+		i = end
+	}
+	return mask
+}
+
+func MapSystemTextProse(text string, replace func(string) string) string {
+	mask := SystemTextCodeMask(text)
+	var out strings.Builder
+	for i := 0; i < len(text); {
+		end := i + 1
+		for end < len(text) && mask[end] == mask[i] {
+			end++
+		}
+		if mask[i] {
+			out.WriteString(text[i:end])
+		} else {
+			out.WriteString(replace(text[i:end]))
+		}
+		i = end
+	}
+	return out.String()
+}
