+package util
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestNeutralizeClaudeCodeSystemIdentity(t *testing.T) {
+	tests := []struct{ name, input, want string }{
+		{"cli", "You are Claude Code, Anthropic's official CLI for Claude.", "You are a coding assistant."},
+		{"cli sdk", "You are Claude Code, Anthropic's official CLI for Claude, running within the Claude Agent SDK.", "You are a coding assistant."},
+		{"agent sdk", "You are a Claude agent, built on Anthropic's Claude Agent SDK.", "You are a coding agent."},
+		{"preserve surrounding bytes", "\tRules\nYou are Claude Code, Anthropic's official CLI for Claude.\nRead CLAUDE.md.  ", "\tRules\nYou are a coding assistant.\nRead CLAUDE.md.  "},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got := NeutralizeClaudeCodeSystemIdentity(tt.input)
+			if got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+			if again := NeutralizeClaudeCodeSystemIdentity(got); again != got {
+				t.Fatalf("replacement is not idempotent: %q", again)
+			}
+		})
+	}
+}
+
+func TestNeutralizeClaudeCodeSystemIdentityPreservesOtherText(t *testing.T) {
+	for _, text := range []string{
+		"", "CLAUDE.md claude.ai anthropic-version x-anthropic-beta x-anthropic-* Claude",
+		"x-anthropic-billing-header: cc_version=sample; cch=12345;",
+		"You are Claude Code, Anthropic's official CLI for Claude",
+		"You are Claude Code, Anthropic's official CLI for Claude, running within a different SDK.",
+		strings.ToLower("You are Claude Code, Anthropic's official CLI for Claude."),
+	} {
+		if got := NeutralizeClaudeCodeSystemIdentity(text); got != text {
+			t.Errorf("changed unrelated text: %q -> %q", text, got)
+		}
+	}
+}
+
+func TestStripLeadingClaudeCodeBillingLines(t *testing.T) {
+	for _, tc := range []struct{ input, want string }{
+		{"\n\t x-anthropic-billing-header: sample\r\nKeep.  ", "Keep.  "},
+		{"x-anthropic-billing-header: a\nx-anthropic-billing-header: b\nKeep.", "Keep."},
+		{"x-anthropic-billing-header: a", ""},
+		{"x-anthropic-billing-header: a\n  ", "  "},
+		{"Keep.\nx-anthropic-billing-header: guidance", "Keep.\nx-anthropic-billing-header: guidance"},
+		{"`x-anthropic-billing-header: sample`", "`x-anthropic-billing-header: sample`"},
+		{"```\nx-anthropic-billing-header: sample\n```", "```\nx-anthropic-billing-header: sample\n```"},
+	} {
+		if got := StripLeadingClaudeCodeBillingLines(tc.input); got != tc.want {
+			t.Errorf("%q => %q, want %q", tc.input, got, tc.want)
+		}
+	}
+}
diff --git a/internal/translator/antigravity/claude/system_prompt_sanitizer.go b/internal/translator/antigravity/claude/system_prompt_sanitizer.go
new file mode 100644
--- /dev/null
+++ b/internal/translator/antigravity/claude/system_prompt_sanitizer.go
@@ -0,0 +1,180 @@
+// Some behavior is based on antigravity-claude-proxy (MIT).
+// Copyright (c) 2024 Badri Narayanan S. See THIRD_PARTY_NOTICES.md in Matou.
+// This implementation is independently written; no Manager code or regex is used.
+package claude
+
+import (
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+)
+
+const antigravitySanitizedIdentity = "You are Antigravity, an agentic AI coding assistant."
+
+var antigravityIdentitySentences = strings.NewReplacer(
+	"You are Claude Code, Anthropic's official CLI for Claude.", antigravitySanitizedIdentity,
+	"You are Claude Code, Anthropic's official CLI for Claude, running within the Claude Agent SDK.", antigravitySanitizedIdentity,
+	"You are a Claude agent, built on Anthropic's Claude Agent SDK.", antigravitySanitizedIdentity,
+)
+
+var antigravityCompetitorNames = []string{
+	"OpenAI", "Anthropic", "DeepSeek", "Qwen", "ByteDance", "Tencent",
+	"Xiaomi", "Huawei", "Baidu", "Mistral", "Cohere",
+	"字节跳动", "腾讯", "小米", "华为", "通义千问", "百度", "深度求索",
+}
+
+var antigravityClientNames = []struct{ name, replacement string }{
+	{"Nous Research", "the assistant team"},
+	{"Hermes Agent", "the assistant"},
+	{"Hermes", "the assistant"},
+	{"Claude Code", "the assistant"},
+}
+
+// sanitizeAntigravitySystemText is called only while constructing system parts.
+// It never receives a request object, user content, tools, or schemas.
+func sanitizeAntigravitySystemText(text string) string {
+	text = stripAntigravityBillingLines(text)
+	text = util.MapSystemTextProse(text, antigravityIdentitySentences.Replace)
+	limit := antigravityBrandWindow(text)
+	// Keep offsets in the complete part, including protected code, so splitting
+	// prose at backticks cannot restart or extend the brand window.
+	mask := util.SystemTextCodeMask(text)
+	var out strings.Builder
+	for i := 0; i < len(text); {
+		if mask[i] {
+			out.WriteByte(text[i])
+			i++
+			continue
+		}
+		// Header identifiers are explicit exemptions even though '-' is a word
+		// boundary. Keep the complete x-anthropic-* token, including mixed case.
+		if antigravityWordStart(text, i) {
+			end := i
+			if antigravityEqualPrefix(text[i:], "anthropic-version") {
+				end += len("anthropic-version")
+			} else if antigravityEqualPrefix(text[i:], "x-anthropic-") {
+				end += len("x-anthropic-")
+				for end < len(text) && (antigravityWordRune(rune(text[end])) || text[end] == '-' || text[end] == '*') {
+					end++
+				}
+			}
+			if end > i {
+				out.WriteString(text[i:end])
+				i = end
+				continue
+			}
+		}
+		matched := false
+		if i < limit {
+			// Chinese names match inside prose; English names keep word boundaries.
+			for _, name := range antigravityCompetitorNames {
+				end := i + len(name)
+				if end <= limit && antigravityEqualPrefix(text[i:], name) && (name[0] >= utf8.RuneSelf || antigravityWholeWord(text, i, end)) && !antigravityProtected(mask, i, end) {
+					out.WriteString("Google")
+					i, matched = end, true
+					break
+				}
+			}
+		}
+		if !matched {
+			for _, rule := range antigravityClientNames {
+				end := i + len(rule.name)
+				if strings.HasPrefix(text[i:], rule.name) && antigravityWholeWord(text, i, end) && !antigravityProtected(mask, i, end) {
+					out.WriteString(rule.replacement)
+					i, matched = end, true
+					break
+				}
+			}
+		}
+		if !matched {
+			_, size := utf8.DecodeRuneInString(text[i:])
+			out.WriteString(text[i : i+size])
+			i += size
+		}
+	}
+	return out.String()
+}
+
+func stripAntigravityBillingLines(text string) string {
+	mask := util.SystemTextCodeMask(text)
+	var out strings.Builder
+	for start := 0; start < len(text); {
+		end := start
+		for end < len(text) && text[end] != '\n' && text[end] != '\r' {
+			end++
+		}
+		next := end
+		if next < len(text) && text[next] == '\r' {
+			next++
+		}
+		if next < len(text) && text[next] == '\n' {
+			next++
+		}
+		line := strings.TrimLeft(text[start:end], " \t")
+		if !antigravityEqualPrefix(line, "x-anthropic-billing-header:") || antigravityProtected(mask, start, end) {
+			out.WriteString(text[start:next])
+		}
+		start = next
+	}
+	return out.String()
+}
+
+// The window is measured after billing removal and exact identity replacement,
+// before any length-changing brand/client substitutions. Newlines are not sentences.
+func antigravityBrandWindow(text string) int {
+	chars, sentences := 0, 0
+	previousEnd := false
+	for i, r := range text {
+		if chars == 1500 {
+			return i
+		}
+		chars++
+		isEnd := strings.ContainsRune(".!?。！？", r)
+		if isEnd && !previousEnd {
+			sentences++
+			if sentences == 8 {
+				return i + utf8.RuneLen(r)
+			}
+		}
+		previousEnd = isEnd
+	}
+	return len(text)
+}
+
+func antigravityEqualPrefix(text, prefix string) bool {
+	return len(text) >= len(prefix) && strings.EqualFold(text[:len(prefix)], prefix)
+}
+
+func antigravityWordRune(r rune) bool {
+	return unicode.IsLetter(r) || unicode.IsDigit(r) || unicode.IsMark(r) || r == '_'
+}
+
+func antigravityWordStart(text string, start int) bool {
+	if start == 0 {
+		return true
+	}
+	r, _ := utf8.DecodeLastRuneInString(text[:start])
+	return !antigravityWordRune(r)
+}
+
+func antigravityWholeWord(text string, start, end int) bool {
+	if !antigravityWordStart(text, start) {
+		return false
+	}
+	if end == len(text) {
+		return true
+	}
+	r, _ := utf8.DecodeRuneInString(text[end:])
+	return !antigravityWordRune(r)
+}
+
+func antigravityProtected(mask []bool, start, end int) bool {
+	for _, protected := range mask[start:end] {
+		if protected {
+			return true
+		}
+	}
+	return false
+}
