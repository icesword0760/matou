+func appendAuthExtraModels(auth *coreauth.Auth, provider string, models []*ModelInfo, excluded []string) []*ModelInfo {
+	if auth == nil || auth.Metadata == nil {
+		return models
+	}
+	raw, ok := auth.Metadata["extra_models"]
+	if !ok || raw == nil {
+		return models
+	}
+	entries, ok := raw.([]any)
+	if !ok || len(entries) == 0 {
+		return models
+	}
+	modelType := strings.ToLower(strings.TrimSpace(provider))
+	if modelType == "" {
+		modelType = strings.ToLower(strings.TrimSpace(auth.Provider))
+	}
+	ownedBy := modelType
+	for _, model := range models {
+		if model != nil {
+			if model.Type != "" {
+				modelType = model.Type
+			}
+			if model.OwnedBy != "" {
+				ownedBy = model.OwnedBy
+			}
+			break
+		}
+	}
+	seen := make(map[string]struct{}, len(models)+len(entries))
+	for _, model := range models {
+		if model != nil && strings.TrimSpace(model.ID) != "" {
+			seen[strings.ToLower(strings.TrimSpace(model.ID))] = struct{}{}
+		}
+	}
+	added := make([]*ModelInfo, 0, len(entries))
+	for _, item := range entries {
+		var id, displayName, itemOwnedBy string
+		var contextLength, maxCompletion int
+		var levels []string
+		switch v := item.(type) {
+		case string:
+			id = strings.TrimSpace(v)
+		case map[string]any:
+			if s, ok := v["id"].(string); ok {
+				id = strings.TrimSpace(s)
+			}
+			if s, ok := v["display_name"].(string); ok {
+				displayName = strings.TrimSpace(s)
+			}
+			if s, ok := v["owned_by"].(string); ok {
+				itemOwnedBy = strings.TrimSpace(s)
+			}
+			contextLength = extraModelInt(v["context_length"])
+			maxCompletion = extraModelInt(v["max_completion_tokens"])
+			if rawLevels, ok := v["thinking_levels"].([]any); ok {
+				for _, rl := range rawLevels {
+					if ls, ok := rl.(string); ok && strings.TrimSpace(ls) != "" {
+						levels = append(levels, strings.TrimSpace(ls))
+					}
+				}
+			}
+		}
+		if id == "" {
+			continue
+		}
+		key := strings.ToLower(id)
+		if _, exists := seen[key]; exists {
+			continue
+		}
+		seen[key] = struct{}{}
+		if displayName == "" {
+			displayName = id
+		}
+		if itemOwnedBy == "" {
+			itemOwnedBy = ownedBy
+		}
+		info := &ModelInfo{
+			ID:                  id,
+			Type:                modelType,
+			OwnedBy:             itemOwnedBy,
+			DisplayName:         displayName,
+			ContextLength:       contextLength,
+			MaxCompletionTokens: maxCompletion,
+			UserDefined:         true,
+		}
+		if len(levels) > 0 {
+			info.Thinking = &registry.ThinkingSupport{Levels: levels}
+		}
+		added = append(added, info)
+	}
+	if len(added) == 0 {
+		return models
+	}
+	added = applyExcludedModels(added, excluded)
+	if len(added) == 0 {
+		return models
+	}
+	out := make([]*ModelInfo, 0, len(models)+len(added))
+	out = append(out, models...)
+	out = append(out, added...)
 	return out
 }
 
+func extraModelInt(v any) int {
+	switch n := v.(type) {
+	case int:
+		return n
+	case int64:
+		return int(n)
+	case float64:
+		return int(n)
+	case json.Number:
+		if iv, err := n.Int64(); err == nil {
+			return int(iv)
+		}
+	}
+	return 0
+}
+
 func applyOAuthSettings(cfg *config.Config, provider, authKind string, models []*ModelInfo) []*ModelInfo {
 	return applyOAuthSettingsForAuth(cfg, provider, authKind, models)
 }
