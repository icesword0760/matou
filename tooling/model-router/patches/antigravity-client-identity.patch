+func TestCodexBillingPrefixPreservesBodyAndLayout(t *testing.T) {
+	for _, shape := range []string{"string", "array"} {
+		t.Run(shape, func(t *testing.T) {
+			for _, newline := range []string{"\n", "\r\n", "\r"} {
+				body := "  Keep project rules." + newline + "Read CLAUDE.md." + newline + "x-anthropic-billing-header: this later line is guidance"
+				text := subscriptionBilling + newline + body
+				var system any = text
+				if shape == "array" {
+					system = []any{map[string]any{"type": "text", "text": text, "cache_control": map[string]string{"type": "ephemeral"}}, map[string]string{"type": "text", "text": "Second part."}}
+				}
+				input := subscriptionPayload(t, system)
+				output, err := codexclaude.ConvertClaudeRequestToCodex("codex-test", input, false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				// Compare the complete request against translating the retained text: this
+				// covers role, part order, empty instructions, user text, tools and schemas.
+				var expectedSystem any = body
+				if shape == "array" {
+					expectedSystem = []any{map[string]any{"type": "text", "text": body, "cache_control": map[string]string{"type": "ephemeral"}}, map[string]string{"type": "text", "text": "Second part."}}
+				}
+				expected, err := codexclaude.ConvertClaudeRequestToCodex("codex-test", subscriptionPayload(t, expectedSystem), false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !bytes.Equal(output, expected) {
+					t.Fatalf("billing prefix dropped body or changed layout:\ngot %s\nwant %s", output, expected)
+				}
+				if got := ojson.GetBytes(output, "input.0.content.0.text").String(); got != body {
+					t.Fatalf("body = %q, want %q", got, body)
+				}
+				t.Logf("%s: before billing + %q; after %q", shape, body, ojson.GetBytes(output, "input.0.content.0.text").String())
+			}
+		})
+	}
