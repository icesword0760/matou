+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("stream=%t", stream), func(t *testing.T) {
+			body := antigravityTranslationBoundaryRequest(t, "claude-sonnet-4-5", payload, stream)
+			system := ojson.GetBytes(body, "request.systemInstruction")
+			if system.Get("parts.#").Int() != 1 || system.Get("parts.0.text").String() != "You are Antigravity, a powerful agentic AI coding assistant designed by the Google Deepmind team working on Advanced Agentic Coding.\nKeep `OpenAI` unchanged." {
+				t.Fatalf("system layout, sanitizer, or code exemption changed: %s", system.Raw)
+			}
+			if strings.Contains(string(body), "MCP XML") || strings.Contains(string(body), "SYSTEM_PROMPT_END") {
+				t.Fatalf("unexpected prompt injection: %s", body)
+			}
+			contents := ojson.GetBytes(body, "request.contents").Array()
+			var calls, results []ojson.Result
+			for _, content := range contents {
+				for _, part := range content.Get("parts").Array() {
+					if fc := part.Get("functionCall"); fc.Exists() {
+						calls = append(calls, fc)
+					}
+					if fr := part.Get("functionResponse"); fr.Exists() {
+						results = append(results, fr)
+					}
+				}
+			}
+			if len(calls) != 2 || len(results) != 2 {
+				t.Fatalf("parallel call/result lost: %s", body)
+			}
+			for i, title := range []string{"first", "second"} {
+				id := fmt.Sprintf("call-%d", i+1)
+				if calls[i].Get("id").String() != id || results[i].Get("id").String() != id || calls[i].Get("name").String() != "mcp__docs__read" || results[i].Get("name").String() != "mcp__docs__read" {
+					t.Fatalf("parallel identity/alignment lost: %s", body)
+				}
+				if calls[i].Get("args.title").String() != title || calls[i].Get("args.format").String() != "raw" {
+					t.Fatalf("schema cleaner mutated historical tool arguments: %s", body)
+				}
+			}
+			if result := results[0].Get("response.result"); !result.Exists() || result.String() != "" {
+				t.Fatalf("empty result must remain empty: %s", body)
+			}
+			if results[1].Get("response.error").String() != "second failed" {
+				t.Fatalf("error result lost: %s", body)
+			}
+			t.Logf("final request: %s", body)
+		})
+	}
+}
