diff --git a/internal/antigravitytls/antigravitytls.go b/internal/antigravitytls/antigravitytls.go
new file mode 100644
index 0000000..2e7f9bc
--- /dev/null
+++ b/internal/antigravitytls/antigravitytls.go
@@ -0,0 +1,297 @@
+// Package antigravitytls reproduces the TLS and HTTP/2 client identity of the
+// native Antigravity language server for Cloud Code API traffic.
+//
+// The pinned Antigravity 2.29.0 build is a Go 1.28 program (boringcrypto build)
+// whose Cloud Code client advertises ALPN h2 and negotiates HTTP/2. The stock
+// router used to force HTTP/1.1 without ALPN, which made the same OAuth token
+// look like a different client. The ClientHello below is a byte-structured copy
+// of a capture from that native binary: same cipher list, extension order,
+// supported groups (including the P-256/P-384 ML-KEM hybrids that Go 1.28 adds
+// to the list without sending key shares for them), signature algorithms, ALPN
+// and key shares. Random, session ID and key material stay per-connection.
+package antigravitytls
+
+import (
+	"context"
+	"errors"
+	"crypto/tls"
+	"fmt"
+	"net"
+	"net/http"
+	"net/url"
+	"strings"
+	"sync"
+	"time"
+
+	utls "github.com/refraction-networking/utls"
+	log "github.com/sirupsen/logrus"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/cache"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/proxyutil"
+	"golang.org/x/net/http2"
+	"golang.org/x/net/proxy"
+)
+
+// ClientHelloSpec returns the captured Antigravity Cloud Code ClientHello.
+// The spec is built fresh per connection so uTLS can generate new key shares.
+//
+// 4587 (SecP256r1MLKEM768) and 4589 (SecP384r1MLKEM1024) are advertised for
+// fingerprint parity only. No key share is sent for them, exactly like the
+// native client, so a server cannot select them without a HelloRetryRequest.
+func ClientHelloSpec() *utls.ClientHelloSpec {
+	return &utls.ClientHelloSpec{
+		CipherSuites: []uint16{
+			0xc02b, 0xc02f, 0xc02c, 0xc030, 0xcca9, 0xcca8, 0xc009,
+			0xc013, 0xc00a, 0xc014, 0x1301, 0x1302, 0x1303,
+		},
+		CompressionMethods: []uint8{0},
+		Extensions: []utls.TLSExtension{
+			&utls.SNIExtension{},
+			&utls.SupportedPointsExtension{SupportedPoints: []byte{0}},
+			&utls.RenegotiationInfoExtension{Renegotiation: utls.RenegotiateNever},
+			&utls.UtlsExtendedMasterSecretExtension{},
+			&utls.SCTExtension{},
+			&utls.StatusRequestExtension{},
+			&utls.SupportedCurvesExtension{Curves: []utls.CurveID{4588, 4587, 4589, 29, 23, 24, 25}},
+			&utls.SignatureAlgorithmsExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				0x0904, 0x0905, 0x0906, 0x0804, 0x0403, 0x0807, 0x0805, 0x0806,
+				0x0401, 0x0501, 0x0601, 0x0503, 0x0603,
+			}},
+			&utls.SignatureAlgorithmsCertExtension{SupportedSignatureAlgorithms: []utls.SignatureScheme{
+				0x0904, 0x0905, 0x0906, 0x0804, 0x0403, 0x0807, 0x0805, 0x0806,
+				0x0401, 0x0501, 0x0601, 0x0503, 0x0603,
+			}},
+			&utls.ALPNExtension{AlpnProtocols: []string{"h2", "http/1.1"}},
+			&utls.SupportedVersionsExtension{Versions: []uint16{utls.VersionTLS13, utls.VersionTLS12}},
+			// X25519MLKEM768 must stay first: the native client also sends a key
+			// share only for it and X25519.
+			&utls.KeyShareExtension{KeyShares: []utls.KeyShare{{Group: 4588}, {Group: utls.X25519}}},
+		},
+	}
+}
+
+type roundTripperKey struct {
+	scope   string
+	proxy   string
+	timeout time.Duration
+}
+
+const roundTripperCacheCapacity = 8192
+
+// antigravityRoundTripper keeps the captured h2 identity and a leaked-connection
+// pool for Google hosts. Plain HTTP and non-Google HTTPS endpoints (tests,
+// self-hosted base URLs) stay adaptive so the router never hangs on a host that
+// only speaks HTTP/1.1.
+type antigravityRoundTripper struct {
+	dialer    proxy.Dialer
+	timeout   time.Duration
+	plain     *http.Transport
+	secure    *http2.Transport
+	protocols sync.Map // host:port -> negotiated protocol; one probe per origin
+}
+
+func (r *antigravityRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req.URL == nil || !strings.EqualFold(req.URL.Scheme, "https") {
+		return r.plain.RoundTrip(req)
+	}
+	protocol, errProtocol := r.protocolFor(req)
+	if errProtocol != nil {
+		return nil, errProtocol
+	}
+	if protocol == "h2" {
+		return r.secure.RoundTrip(req)
+	}
+	return r.roundTripAdaptive(req)
+}
+
+// protocolFor probes one origin and caches its ALPN result. Production Google
+// endpoints answer h2 and are then served by the pooled transport; test or
+// self-hosted HTTP/1.1 origins keep their one-request-at-a-time path instead of
+// hanging inside an HTTP/2 read loop.
+func (r *antigravityRoundTripper) protocolFor(req *http.Request) (string, error) {
+	port := req.URL.Port()
+	if port == "" {
+		port = "443"
+	}
+	key := net.JoinHostPort(req.URL.Hostname(), port)
+	if cached, ok := r.protocols.Load(key); ok {
+		return cached.(string), nil
+	}
+	tlsConn, errDial := r.dialTLS(req.Context(), req.URL.Hostname(), key)
+	if errDial != nil {
+		return "", errDial
+	}
+	protocol := tlsConn.ConnectionState().NegotiatedProtocol
+	_ = tlsConn.Close()
+	if protocol != "h2" {
+		protocol = "http/1.1"
+	}
+	r.protocols.Store(key, protocol)
+	return protocol, nil
+}
+
+func (r *antigravityRoundTripper) CloseIdleConnections() {
+	if r.secure != nil {
+		r.secure.CloseIdleConnections()
+	}
+	if r.plain != nil {
+		r.plain.CloseIdleConnections()
+	}
+}
+
+func (r *antigravityRoundTripper) dialTLS(ctx context.Context, host, addr string) (*utls.UConn, error) {
+	conn, errDial := dialContext(ctx, r.dialer, "tcp", addr)
+	if errDial != nil {
+		return nil, fmt.Errorf("antigravity tls: dial upstream: %w", errDial)
+	}
+	tlsConn := utls.UClient(conn, &utls.Config{ServerName: host}, utls.HelloCustom)
+	if errPreset := tlsConn.ApplyPreset(ClientHelloSpec()); errPreset != nil {
+		_ = tlsConn.Close()
+		return nil, fmt.Errorf("antigravity tls: apply ClientHello: %w", errPreset)
+	}
+	handshakeCtx, cancelHandshake := handshakeContext(ctx, r.timeout)
+	defer cancelHandshake()
+	if errHandshake := tlsConn.HandshakeContext(handshakeCtx); errHandshake != nil {
+		_ = tlsConn.Close()
+		return nil, fmt.Errorf("antigravity tls: TLS handshake: %w", errHandshake)
+	}
+	return tlsConn, nil
+}
+
+// roundTripAdaptive dispatches on the negotiated ALPN for an endpoint outside
+// the Google surface. It is intentionally one request per connection: those
+// endpoints are not the provider path this fork is shaping.
+func (r *antigravityRoundTripper) roundTripAdaptive(req *http.Request) (*http.Response, error) {
+	port := req.URL.Port()
+	if port == "" {
+		port = "443"
+	}
+	tlsConn, errDial := r.dialTLS(req.Context(), req.URL.Hostname(), net.JoinHostPort(req.URL.Hostname(), port))
+	if errDial != nil {
+		return nil, errDial
+	}
+	if tlsConn.ConnectionState().NegotiatedProtocol == "h2" {
+		h2Conn, errClientConn := (&http2.Transport{}).NewClientConn(tlsConn)
+		if errClientConn != nil {
+			_ = tlsConn.Close()
+			return nil, fmt.Errorf("antigravity tls: initialize HTTP/2 connection: %w", errClientConn)
+		}
+		resp, errRoundTrip := h2Conn.RoundTrip(req)
+		if errRoundTrip != nil {
+			_ = h2Conn.Close()
+			return nil, errRoundTrip
+		}
+		resp.Body = &closeBody{ReadCloser: resp.Body, close: h2Conn.Close}
+		return resp, nil
+	}
+	transport := &http.Transport{
+		DisableKeepAlives: true,
+		DialTLSContext: func(context.Context, string, string) (net.Conn, error) {
+			return tlsConn, nil
+		},
+	}
+	resp, errRoundTrip := transport.RoundTrip(req)
+	transport.CloseIdleConnections()
+	if errRoundTrip != nil {
+		_ = tlsConn.Close()
+		return nil, errRoundTrip
+	}
+	resp.Body = &closeBody{ReadCloser: resp.Body, close: tlsConn.Close}
+	return resp, nil
+}
+
+type closeBody struct {
+	ReadCloser interface {
+		Read([]byte) (int, error)
+		Close() error
+	}
+	close func() error
+	once  sync.Once
+	err   error
+}
+
+func (b *closeBody) Read(p []byte) (int, error) { return b.ReadCloser.Read(p) }
+
+func (b *closeBody) Close() error {
+	b.once.Do(func() {
+		errBody := b.ReadCloser.Close()
+		var errConnection error
+		if b.close != nil {
+			errConnection = b.close()
+		}
+		b.err = errors.Join(errBody, errConnection)
+	})
+	return b.err
+}
+
+var roundTrippers = cache.NewBoundedLRU[roundTripperKey, *antigravityRoundTripper](
+	roundTripperCacheCapacity,
+	func(_ roundTripperKey, transport *antigravityRoundTripper) {
+		if transport != nil {
+			transport.CloseIdleConnections()
+		}
+	},
+)
+
+// RoundTripper returns a connection-pooling transport that presents the native
+// Antigravity ClientHello. scope keeps pools separated per credential; proxyURL
+// is the already-resolved router proxy ("" means direct). timeout bounds only
+// the TLS handshake; zero keeps the caller's context as-is.
+func RoundTripper(scope, proxyURL string, timeout time.Duration) http.RoundTripper {
+	key := roundTripperKey{scope: strings.TrimSpace(scope), proxy: strings.TrimSpace(proxyURL), timeout: timeout}
+	return roundTrippers.GetOrAdd(key, func() *antigravityRoundTripper {
+		return newRoundTripper(key.proxy, timeout)
+	})
+}
+
+func newRoundTripper(proxyURL string, timeout time.Duration) *antigravityRoundTripper {
+	var dialer proxy.Dialer = proxy.Direct
+	if proxyURL != "" {
+		proxyDialer, mode, errBuild := proxyutil.BuildDialer(proxyURL)
+		if errBuild != nil {
+			log.Errorf("antigravity tls: failed to configure proxy dialer for %q: %v", proxyutil.Redact(proxyURL), errBuild)
+		} else if mode != proxyutil.ModeInherit && proxyDialer != nil {
+			dialer = proxyDialer
+		}
+	}
+	plain := &http.Transport{}
+	if parsed, errParse := url.Parse(proxyURL); proxyURL != "" && errParse == nil && (parsed.Scheme == "http" || parsed.Scheme == "https") {
+		plain.Proxy = http.ProxyURL(parsed)
+	} else if proxyURL != "" {
+		plain.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
+			return dialContext(ctx, dialer, network, addr)
+		}
+	}
+	roundTripper := &antigravityRoundTripper{dialer: dialer, timeout: timeout, plain: plain}
+	roundTripper.secure = &http2.Transport{
+		DialTLSContext: func(ctx context.Context, _, addr string, _ *tls.Config) (net.Conn, error) {
+			host, _, errSplit := net.SplitHostPort(addr)
+			if errSplit != nil {
+				return nil, fmt.Errorf("antigravity tls: split upstream address: %w", errSplit)
+			}
+			tlsConn, errDial := roundTripper.dialTLS(ctx, host, addr)
+			if errDial != nil {
+				return nil, errDial
+			}
+			if protocol := tlsConn.ConnectionState().NegotiatedProtocol; protocol != "h2" {
+				_ = tlsConn.Close()
+				return nil, fmt.Errorf("antigravity tls: upstream negotiated %q, want h2", protocol)
+			}
+			return tlsConn, nil
+		},
+	}
+	return roundTripper
+}
+
+func dialContext(ctx context.Context, dialer proxy.Dialer, network, addr string) (net.Conn, error) {
+	if contextDialer, ok := dialer.(proxy.ContextDialer); ok {
+		return contextDialer.DialContext(ctx, network, addr)
+	}
+	return dialer.Dial(network, addr)
+}
+
+func handshakeContext(ctx context.Context, timeout time.Duration) (context.Context, context.CancelFunc) {
+	if timeout <= 0 {
+		return ctx, func() {}
+	}
+	return context.WithTimeout(ctx, timeout)
+}
