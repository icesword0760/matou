+	ensureHeaderWithConfigPrecedence(target, client, "User-Agent", "codex_cli_rs/0.159.0 (Mac OS 26.5.2; arm64)", "codex-tui/0.154.0")
+	if got := target.Get("User-Agent"); got != "codex_cli_rs/0.159.0 (Mac OS 26.5.2; arm64)" {
+		t.Fatalf("User-Agent = %q, want the configured Codex agent", got)
+	}
+}
