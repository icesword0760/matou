+func (h *Handler) apiCallTransport(ctx context.Context, auth *coreauth.Auth, requestProxyURL string) http.RoundTripper {
+	proxyURL, proxies := h.apiCallProxyURL(auth, requestProxyURL)
+	// Probes for an Antigravity token must present the same TLS and HTTP/2
+	// identity as inference, otherwise one token still looks like two clients.
+	// A ChatGPT token must look like one Codex client. Inference already uses
+	// the Chrome uTLS transport; probes must not fall back to a Go TLS client.
+	if apiCallUsesCodexSubscription(auth) {
+		client := helps.NewUtlsHTTPClient(ctx, h.cfg, auth, 0)
+		if client != nil && client.Transport != nil {
+			return client.Transport
+		}
+	}
+	if auth != nil && strings.EqualFold(strings.TrimSpace(auth.Provider), "antigravity") {
+		scope := strings.TrimSpace(auth.Index)
+		if scope == "" {
+			scope = strings.TrimSpace(auth.ID)
+		}
+		var handshakeTimeout time.Duration
+		if h != nil && h.cfg != nil {
+			handshakeTimeout = h.cfg.TLSHandshakeTimeout()
+		}
+		return antigravitytls.RoundTripper("management:"+scope, proxyURL, handshakeTimeout)
+	}
+	if proxyURL != "" {
+		if transport := buildProxyTransport(proxyURL); transport != nil {
 			return transport
 		}
 		return directAPICallTransport()
 	}
+	for _, proxyStr := range proxies {
+		if transport := buildProxyTransport(proxyStr); transport != nil {
+			return transport
+		}
+	}
+	return directAPICallTransport()
+}
 
+// apiCallUsesCodexSubscription reports an OAuth ChatGPT subscription. API-key
+// Codex credentials keep the standard transport and their configured proxy.
+func apiCallUsesCodexSubscription(auth *coreauth.Auth) bool {
+	if auth == nil || !strings.EqualFold(strings.TrimSpace(auth.Provider), "codex") {
+		return false
+	}
+	if auth.AuthKind() == coreauth.AuthKindAPIKey {
+		return false
+	}
+	return auth.Attributes == nil || strings.TrimSpace(auth.Attributes["api_key"]) == ""
+}
+
+// apiCallProxyURL resolves the proxy an API call should use. It returns the
