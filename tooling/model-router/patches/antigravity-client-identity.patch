+package executor
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// Exercise the executor boundary: translation alone does not include thinking
+// normalization, provider caps, signature replay, or final HTTP serialization.
+// The transport is entirely in memory; no credentials or upstream are used.
+func antigravityTranslationBoundaryRequest(t *testing.T, model string, payload []byte, stream bool) []byte {
+	t.Helper()
+	var captured []byte
+	calls := 0
+	ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if !strings.HasSuffix(req.URL.Path, ":streamGenerateContent") && !strings.HasSuffix(req.URL.Path, ":generateContent") {
+			return nil, fmt.Errorf("unexpected upstream path: %s", req.URL.Path)
+		}
+		var err error
+		captured, err = io.ReadAll(req.Body)
+		if err != nil {
+			return nil, err
+		}
+		_ = req.Body.Close()
+		reply := `{"response":{"candidates":[{"content":{"role":"model","parts":[{"text":"OK"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":1,"candidatesTokenCount":1,"totalTokenCount":2}}}`
+		contentType := "application/json"
+		if strings.HasSuffix(req.URL.Path, ":streamGenerateContent") {
+			reply = "data: " + reply + "\n\n"
+			contentType = "text/event-stream"
+		}
+		return &http.Response{StatusCode: http.StatusOK, Header: http.Header{"Content-Type": {contentType}}, Body: io.NopCloser(strings.NewReader(reply)), Request: req}, nil
+	}))
+	executor := NewAntigravityExecutor(&config.Config{})
+	auth := &cliproxyauth.Auth{ID: "translation-boundary", Provider: "antigravity", Metadata: map[string]any{
+		"access_token": "test-token", "project_id": "test-project", "expired": time.Now().Add(time.Hour).Format(time.RFC3339),
+	}}
+	req := cliproxyexecutor.Request{Model: model, Payload: payload}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, OriginalRequest: payload, Stream: stream}
+	if stream {
+		res, err := executor.ExecuteStream(ctx, auth, req, opts)
+		if err != nil {
+			t.Fatalf("ExecuteStream: %v", err)
+		}
+		for chunk := range res.Chunks {
+			if chunk.Err != nil {
+				t.Fatalf("stream chunk: %v", chunk.Err)
+			}
+		}
+	} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	if calls != 1 || !ojson.ValidBytes(captured) {
+		t.Fatalf("expected one valid final HTTP request, calls=%d body=%s", calls, captured)
+	}
+	return captured
+}
+
+func TestAntigravityTranslationBoundaryBudget(t *testing.T) {
+	const model = "claude-sonnet-4-5"
+	// Capability fixture for a budget-capable Claude model. Production obtains
+	// these limits from its registry; no static model catalog is assumed here.
+	client := "translation-boundary-budget"
+	registry.GetGlobalRegistry().RegisterClient(client, "antigravity", []*registry.ModelInfo{{
+		ID: model, MaxCompletionTokens: 64000,
+		Thinking: &registry.ThinkingSupport{Min: 1024, Max: 32768, ZeroAllowed: true, DynamicAllowed: true},
+	}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(client) })
+	for _, stream := range []bool{false, true} {
+		for _, tc := range []struct {
+			name                             string
+			max, budget, wantMax, wantBudget int
+			wantThinking                     bool
+		}{
+			{"budget below max", 8192, 4096, 8192, 4096, true},
+			{"budget equal max", 4096, 4096, 4096, 4095, true},
+			{"budget above max", 4096, 8192, 4096, 4095, true},
+			{"max below minimum thinking", 1024, 8192, 1024, 0, false},
+			{"dynamic budget", 4096, -1, 4096, -1, true},
+			{"registry output cap", 128000, 8192, 64000, 8192, true},
+		} {
+			t.Run(fmt.Sprintf("%s/stream=%t", tc.name, stream), func(t *testing.T) {
+				payload := []byte(fmt.Sprintf(`{"model":%q,"max_tokens":%d,"thinking":{"type":"enabled","budget_tokens":%d},"messages":[{"role":"user","content":"Reply OK"}]}`, model, tc.max, tc.budget))
+				translated := sdktranslator.TranslateRequest(sdktranslator.FormatClaude, sdktranslator.FormatAntigravity, model, payload, stream)
+				// Demonstrate why separately inspecting the translator would
+				// incorrectly classify this as a missing protocol safeguard.
+				if got := ojson.GetBytes(translated, "request.generationConfig.thinkingConfig.thinkingBudget").Int(); got != int64(tc.budget) {
+					t.Fatalf("translator budget=%d, want original %d", got, tc.budget)
+				}
+				body := antigravityTranslationBoundaryRequest(t, model, payload, stream)
+				max := ojson.GetBytes(body, "request.generationConfig.maxOutputTokens").Int()
+				thinking := ojson.GetBytes(body, "request.generationConfig.thinkingConfig")
+				budget := thinking.Get("thinkingBudget").Int()
+				if max != int64(tc.wantMax) || thinking.Exists() != tc.wantThinking || (tc.wantThinking && budget != int64(tc.wantBudget)) {
+					t.Fatalf("unexpected final budget/max: %s", body)
+				}
+				if tc.wantThinking && budget > 0 && budget >= max {
+					t.Fatalf("positive budget must be below max: %s", body)
+				}
+				t.Logf("translator max/budget=%d/%d; final max=%d thinking=%s", tc.max, tc.budget, max, thinking.Raw)
+			})
+		}
+	}
+}
