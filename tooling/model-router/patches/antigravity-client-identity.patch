+func TestAntigravityDisableCoolingConfig(t *testing.T) {
+	cfg, err := internalconfig.ParseConfigBytes([]byte(`{"config-version": 8, "oauth": {"providers": {"antigravity": {"disable-cooling": true}}}}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.QuotaExceeded.AntigravityDisableCooling {
+		t.Fatal("oauth.providers.antigravity.disable-cooling was not parsed")
+	}
+	if !quotaCooldownDisabledForAuthWithConfig(&Auth{Provider: "antigravity"}, cfg) {
+		t.Fatal("antigravity 429 must not cool down when disabled")
+	}
+	if quotaCooldownDisabledForAuthWithConfig(&Auth{Provider: "codex"}, cfg) {
+		t.Fatal("codex cooling policy changed")
+	}
+	if quotaCooldownDisabledForAuthWithConfig(&Auth{Provider: "antigravity", Metadata: map[string]any{"disable_cooling": false}}, cfg) {
+		t.Fatal("explicit credential override must win")
+	}
+	if quotaCooldownDisabledForAuthWithConfig(&Auth{Provider: "antigravity"}, &internalconfig.Config{}) {
+		t.Fatal("default antigravity cooling policy changed")
+	}
