@@ -0,0 +1,303 @@
+package translator
+
+import (
+	"bytes"
+	"encoding/json"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/MoeForge/moego/ojson"
+	antigravityclaude "github.com/router-for-me/CLIProxyAPI/v8/internal/translator/antigravity/claude"
+	codexclaude "github.com/router-for-me/CLIProxyAPI/v8/internal/translator/codex/claude"
+)
+
+const subscriptionBilling = "\n\t x-anthropic-billing-header: cc_version=sample; cch=12345;"
+
+var subscriptionIdentities = []string{
+	"You are Claude Code, Anthropic's official CLI for Claude.",
+	"You are Claude Code, Anthropic's official CLI for Claude, running within the Claude Agent SDK.",
+	"You are a Claude agent, built on Anthropic's Claude Agent SDK.",
+}
+
+const subscriptionGuidance = "Read CLAUDE.md; use claude.ai; keep anthropic-version, x-anthropic-beta and Claude.\nx-anthropic-custom: keep this lowercase header."
+
+type subscriptionTranslation struct {
+	name, model, systemParts, userText, tool, schema string
+	convert                                          func(string, []byte, bool) ([]byte, error)
+}
+
+var subscriptionTranslations = []subscriptionTranslation{
+	{"antigravity", "claude-sonnet-4-5", "request.systemInstruction.parts", "request.contents.0.parts.0.text", "request.tools.0.functionDeclarations.0", "parametersJsonSchema", antigravityclaude.ConvertClaudeRequestToAntigravity},
+	{"codex", "codex-test", "input.0.content", "input.1.content.0.text", "tools.0", "parameters", codexclaude.ConvertClaudeRequestToCodex},
+}
+
+func subscriptionPayload(t *testing.T, system any) []byte {
+	t.Helper()
+	// Identity and billing strings deliberately also occur outside system.
+	protected := strings.Join(subscriptionIdentities, "\n") + subscriptionBilling
+	payload, err := json.Marshal(map[string]any{
+		"system":   system,
+		"messages": []any{map[string]any{"role": "user", "content": protected}},
+		"tools": []any{map[string]any{
+			"name": "Claude", "description": protected,
+			"input_schema": map[string]any{"type": "object", "properties": map[string]any{
+				"text": map[string]any{"type": "string", "description": protected},
+			}},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return payload
+}
+
+func TestSubscriptionPromptTranslations(t *testing.T) {
+	for _, route := range subscriptionTranslations {
+		t.Run(route.name, func(t *testing.T) {
+			for _, shape := range []string{"array", "string"} {
+				t.Run(shape, func(t *testing.T) {
+					want := []string{"You are a coding assistant.", "You are a coding assistant.", "You are a coding agent.", subscriptionGuidance}
+					if route.name == "antigravity" {
+						for i := 0; i < 3; i++ {
+							want[i] = "You are Antigravity, an agentic AI coding assistant."
+						}
+					}
+					var system any
+					if shape == "array" {
+						parts := []any{map[string]any{"type": "text", "text": subscriptionBilling}}
+						for _, text := range append(append([]string{}, subscriptionIdentities...), subscriptionGuidance) {
+							parts = append(parts, map[string]any{"type": "text", "text": text, "cache_control": map[string]string{"type": "ephemeral"}})
+						}
+						system = parts
+					} else {
+						system = strings.Join(subscriptionIdentities, "\n") + "\n" + subscriptionGuidance
+						want = []string{strings.Join(want, "\n")}
+					}
+					input := subscriptionPayload(t, system)
+					original := bytes.Clone(input)
+					output, err := route.convert(route.model, input, false)
+					if err != nil {
+						t.Fatal(err)
+					}
+					var got []string
+					for _, part := range ojson.GetBytes(output, route.systemParts).Array() {
+						got = append(got, part.Get("text").String())
+					}
+					if !reflect.DeepEqual(got, want) {
+						t.Fatalf("system parts = %q, want %q", got, want)
+					}
+					protected := strings.Join(subscriptionIdentities, "\n") + subscriptionBilling
+					for _, path := range []string{route.userText, route.tool + ".description", route.tool + "." + route.schema + ".properties.text.description"} {
+						if got := ojson.GetBytes(output, path).String(); got != protected {
+							t.Errorf("protected %s changed: %q", path, got)
+						}
+					}
+					if got := ojson.GetBytes(output, route.tool+".name").String(); got != "Claude" {
+						t.Errorf("tool name changed: %q", got)
+					}
+					if route.name == "codex" {
+						if got := ojson.GetBytes(output, "input.0.role").String(); got != "developer" {
+							t.Errorf("system role changed: %q", got)
+						}
+						if got := ojson.GetBytes(output, "instructions"); got.Type != ojson.String || got.String() != "" {
+							t.Errorf("instructions must remain empty: %s", got.Raw)
+						}
+					}
+					if !bytes.Equal(input, original) {
+						t.Fatal("source payload mutated")
+					}
+					repeated, err := route.convert(route.model, input, false)
+					if err != nil || !bytes.Equal(repeated, output) {
+						t.Fatalf("identical input must produce a stable prompt: %v", err)
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestSubscriptionPromptBillingOnlySystem(t *testing.T) {
+	for _, route := range subscriptionTranslations {
+		t.Run(route.name, func(t *testing.T) {
+			for _, system := range []any{subscriptionBilling, []any{map[string]string{"type": "text", "text": subscriptionBilling}}} {
+				output, err := route.convert(route.model, subscriptionPayload(t, system), false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if route.name == "antigravity" {
+					if ojson.GetBytes(output, "request.systemInstruction").Exists() {
+						t.Fatalf("billing-only system must be dropped: %s", output)
+					}
+				} else if got := ojson.GetBytes(output, "input.0.role").String(); got != "user" {
+					t.Fatalf("billing-only developer message must be dropped: %s", output)
+				}
+			}
+		})
+	}
+}
+
+func TestCodexBillingPrefixPreservesBodyAndLayout(t *testing.T) {
+	for _, shape := range []string{"string", "array"} {
+		t.Run(shape, func(t *testing.T) {
+			for _, newline := range []string{"\n", "\r\n", "\r"} {
+				body := "  Keep project rules." + newline + "Read CLAUDE.md." + newline + "x-anthropic-billing-header: this later line is guidance"
+				text := subscriptionBilling + newline + body
+				var system any = text
+				if shape == "array" {
+					system = []any{map[string]any{"type": "text", "text": text, "cache_control": map[string]string{"type": "ephemeral"}}, map[string]string{"type": "text", "text": "Second part."}}
+				}
+				input := subscriptionPayload(t, system)
+				output, err := codexclaude.ConvertClaudeRequestToCodex("codex-test", input, false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				// Compare the complete request against translating the retained text: this
+				// covers role, part order, empty instructions, user text, tools and schemas.
+				var expectedSystem any = body
+				if shape == "array" {
+					expectedSystem = []any{map[string]any{"type": "text", "text": body, "cache_control": map[string]string{"type": "ephemeral"}}, map[string]string{"type": "text", "text": "Second part."}}
+				}
+				expected, err := codexclaude.ConvertClaudeRequestToCodex("codex-test", subscriptionPayload(t, expectedSystem), false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !bytes.Equal(output, expected) {
+					t.Fatalf("billing prefix dropped body or changed layout:\ngot %s\nwant %s", output, expected)
+				}
+				if got := ojson.GetBytes(output, "input.0.content.0.text").String(); got != body {
+					t.Fatalf("body = %q, want %q", got, body)
+				}
+				t.Logf("%s: before billing + %q; after %q", shape, body, ojson.GetBytes(output, "input.0.content.0.text").String())
+			}
+		})
+	}
+}
+
+func TestCodexSystemIdentityProtectsCode(t *testing.T) {
+	for _, identity := range subscriptionIdentities {
+		for _, wrapper := range []string{"`%s`", "``%s``", "```text\n%s\n```", "```text\n%s", "`%s"} {
+			protected := strings.ReplaceAll(wrapper, "%s", identity)
+			text := identity + "\n" + protected + "\nRead CLAUDE.md."
+			wantIdentity := "You are a coding assistant."
+			if identity == subscriptionIdentities[2] {
+				wantIdentity = "You are a coding agent."
+			}
+			want := wantIdentity + "\n" + protected + "\nRead CLAUDE.md."
+			for _, system := range []any{text, []any{map[string]string{"type": "text", "text": text}}} {
+				output, err := codexclaude.ConvertClaudeRequestToCodex("codex-test", subscriptionPayload(t, system), false)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if got := ojson.GetBytes(output, "input.0.content.0.text").String(); got != want {
+					t.Fatalf("code changed: got %q, want %q", got, want)
+				}
+			}
+		}
+	}
+}
+
+// Exercise both real translation entry points and both system shapes. Outside
+// prose remains sanitizable, while each complete code sample stays byte-exact.
+func TestSubscriptionPromptCodeRegions(t *testing.T) {
+	identity := subscriptionIdentities[0]
+	code := identity + "\n由腾讯开发，使用通义千问和深度求索。"
+	outside := identity + " 由腾讯开发\n"
+	for _, route := range subscriptionTranslations {
+		t.Run(route.name, func(t *testing.T) {
+			wantOutside := "You are a coding assistant. 由腾讯开发\n"
+			if route.name == "antigravity" {
+				wantOutside = "You are Antigravity, an agentic AI coding assistant. 由Google开发\n"
+			}
+			for _, tc := range []struct {
+				name, sample string
+				unclosed     bool
+			}{
+				{"audit literal backticks", "```python\nmarker = \"```\"\n" + code + "\n```", false},
+				{"ordinary fence", "```text\n" + code + "\n```", false},
+				{"longer closing fence", "````text\n```\n" + code + "\n`````", false},
+				{"indented fence", " \t```text\n" + code + "\n\t ```` \t", false},
+				{"closing fence at EOF", "```\n" + code + "\n```", true},
+				{"non standalone run", "```text\n``` extra\n" + code + "\n```", false},
+				{"embedded long run", "```text\nmarker = \"`````\"\n" + code + "\n```", false},
+				{"unclosed fence", "```text\nmarker = \"```\"\n" + code, true},
+				{"short closing run", "````text\n" + code + "\n```\n" + identity, true},
+				{"inline with literal backtick", "``literal ` " + identity + " 由腾讯开发``", false},
+				{"multiline inline", "`first line\n" + code + "\nlast line`", false},
+				{"multiline double inline", "``first ` line\n" + code + "\nlast ``` line``", false},
+				{"midline triple inline", "example ```first\n" + code + "\nlast```", false},
+				{"exact inline run", "``literal ``` " + identity + " 由腾讯开发``", false},
+				{"protected fence-like run", "``first\n```text\n" + code + "\nlast``", false},
+				{"ordinary inline", "`" + identity + " 由腾讯开发`", false},
+			} {
+				t.Run(tc.name, func(t *testing.T) {
+					for _, newline := range []string{"\n", "\r\n", "\r"} {
+						sample := strings.ReplaceAll(tc.sample, "\n", newline)
+						prefix := strings.ReplaceAll(outside, "\n", newline)
+						wantPrefix := strings.ReplaceAll(wantOutside, "\n", newline)
+						input, want := prefix+sample, wantPrefix+sample
+						if !tc.unclosed {
+							input += newline + prefix
+							want += newline + wantPrefix
+						}
+						for _, system := range []any{input, []any{map[string]string{"type": "text", "text": input}}} {
+							output, err := route.convert(route.model, subscriptionPayload(t, system), false)
+							if err != nil {
+								t.Fatal(err)
+							}
+							parts := ojson.GetBytes(output, route.systemParts).Array()
+							if len(parts) != 1 {
+								t.Fatalf("unexpected system parts: %s", output)
+							}
+							if got := parts[0].Get("text").String(); got != want {
+								t.Fatalf("code/prose boundary changed:\ngot  %q\nwant %q", got, want)
+							}
+						}
+					}
+				})
+			}
+		})
+	}
+}
+
+func TestSubscriptionPromptInlineFallback(t *testing.T) {
+	identity := subscriptionIdentities[0]
+	line := identity + " 由腾讯开发"
+	for _, route := range subscriptionTranslations {
