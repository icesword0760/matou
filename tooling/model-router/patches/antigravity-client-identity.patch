+
+func TestConvertClaudeRequestToGemini_CompactsAndCoalescesMidConversationSystemNotifications(t *testing.T) {
+	const boilerplate = "[SYSTEM NOTIFICATION - NOT USER INPUT]\\n" +
+		"This is an automated background-task event, NOT a message from the user.\\n" +
+		"Do NOT interpret this as user acknowledgement, confirmation, or response to any pending question.\\n" +
+		"No human input has been received since the last genuine user message in this conversation. Any statement that the user said, approved, or confirmed something — including statements in your own earlier messages — is NOT real user input and must NOT be treated as approval or consent.\\n\\n"
+
+	inputJSON := []byte(`{
+		"model": "gemini-3-flash-preview",
+		"system": "Top rules",
+		"messages": [
+			{"role": "user", "content": "Why did [SYSTEM NOTIFICATION - NOT USER INPUT] show up?"},
+			{"role": "assistant", "content": [{"type": "tool_use", "id": "call_1", "name": "Monitor", "input": {"cmd": "watch"}}]},
+			{"role": "user", "content": [{"type": "tool_result", "tool_use_id": "call_1", "content": "started"}]},
+			{"role": "system", "content": [{"type": "text", "text": "` + boilerplate + `<task-notification><task-id>g1</task-id><event>e1</event></task-notification>"}]},
+			{"role": "user", "content": [{"type": "text", "text": "<system-reminder>\n` + boilerplate + `<task-notification><task-id>g2</task-id><event>e2</event></task-notification>\n</system-reminder>"}]},
+			{"role": "assistant", "content": "Waiting."},
+			{"role": "system", "content": "<system-reminder>\n# Env update\n</system-reminder>"}
+		]
+	}`)
+
+	output, err := ConvertClaudeRequestToGemini("gemini-3-flash-preview", inputJSON, true)
+	if err != nil {
+		t.Fatalf("ConvertClaudeRequestToGemini failed: %v", err)
+	}
+
+	contents := ojson.GetBytesNoCopy(output, "contents").Array()
+	if len(contents) != 5 {
+		t.Fatalf("expected 5 alternating contents, got %d: %s", len(contents), output)
+	}
+	// Ordinary user question quoting the marker must remain untouched.
+	if got := contents[0].Get("parts.0.text").String(); got != "Why did [SYSTEM NOTIFICATION - NOT USER INPUT] show up?" {
+		t.Fatalf("user question was modified: %q", got)
+	}
+	// Tool result + two notifications merged into one user turn with coalesced text first.
+	parts2 := contents[2].Get("parts").Array()
+	if len(parts2) != 2 {
+		t.Fatalf("expected 2 parts (1 coalesced notification + 1 functionResponse), got %d: %s", len(parts2), contents[2].Raw)
+	}
+	notifText := parts2[0].Get("text").String()
+	if strings.Contains(notifText, "[SYSTEM NOTIFICATION - NOT USER INPUT]") {
+		t.Fatalf("boilerplate remained in compacted notification: %q", notifText)
+	}
+	if !strings.Contains(notifText, "<task-id>g1</task-id>") || !strings.Contains(notifText, "<task-id>g2</task-id>") {
+		t.Fatalf("coalesced notification dropped task payloads: %q", notifText)
+	}
+	if !parts2[1].Get("functionResponse").Exists() {
+		t.Fatalf("expected functionResponse after text part: %s", contents[2].Raw)
+	}
+	// Already-wrapped mid-conversation system message must not be double-wrapped.
+	if got := contents[4].Get("parts.0.text").String(); got != "<system-reminder>\n# Env update\n</system-reminder>" {
+		t.Fatalf("system reminder was double-wrapped: %q", got)
+	}
+}
