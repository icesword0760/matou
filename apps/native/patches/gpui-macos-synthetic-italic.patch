+    fn synthetic_italic_id(&mut self, base: FontId) -> FontId {
+        if let Some(&alias) = self.synthetic_italic_aliases.get(&base) {
+            return alias;
+        }
+        // Use an independent raster/cache key without replacing the physical
+        // font returned by the PostScript-name lookup during CoreText shaping.
+        let alias = FontId(self.fonts.len());
+        self.fonts.push(self.fonts[base.0].clone());
+        self.synthetic_italic_aliases.insert(base, alias);
+        self.synthetic_italic_bases.insert(alias, base);
+        alias
+    }
