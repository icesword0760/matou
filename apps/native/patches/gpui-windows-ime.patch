+#[cfg(test)]
+mod ime_tests {
+    use windows::Win32::{
+        Foundation::{LPARAM, RECT, WPARAM},
+        UI::Input::{
+            Ime::{
+                GCS_COMPATTR, GCS_COMPSTR, GCS_CURSORPOS, GCS_RESULTSTR, IMN_CHANGECANDIDATE,
+                IMN_CLOSECANDIDATE, IMN_OPENCANDIDATE, IMN_SETCANDIDATEPOS,
+                IMN_SETCOMPOSITIONWINDOW, ISC_SHOWUICANDIDATEWINDOW, ISC_SHOWUICOMPOSITIONWINDOW,
+                ISC_SHOWUIGUIDELINE,
+            },
+            KeyboardAndMouse::{VK_A, VK_BACK, VK_LEFT, VK_PROCESSKEY, VK_RETURN, VK_SPACE},
+        },
+    };
+
+    use super::{
+        ImeUpdate, caret_bounds_to_physical_rect, is_ime_process_key, should_sync_ime_notify,
+        strip_ime_composition_window_flag,
+    };
+
+    #[test]
+    fn caret_rect_rounds_at_each_dpi_and_has_minimum_dimensions() {
+        for (scale, left, top, right, bottom) in [
+            (1.0, 10, 21, 13, 36),
+            (1.5, 15, 31, 19, 53),
+            (2.0, 21, 41, 26, 70),
+        ] {
+            assert_eq!(
+                caret_bounds_to_physical_rect(10.25, 20.5, 2.5, 14.5, scale),
+                RECT {
+                    left,
+                    top,
+                    right,
+                    bottom,
+                }
+            );
+        }
+        assert_eq!(
+            caret_bounds_to_physical_rect(10.0, 20.0, 0.1, 0.0, 2.0),
+            RECT {
+                left: 20,
+                top: 40,
+                right: 21,
+                bottom: 41,
+            }
+        );
+    }
+
+    #[test]
+    fn set_context_preserves_candidate_and_other_ui_flags() {
+        let other_flags = (ISC_SHOWUICANDIDATEWINDOW | ISC_SHOWUIGUIDELINE) as isize;
+        let flags = other_flags | ISC_SHOWUICOMPOSITIONWINDOW as isize;
+        assert_eq!(
+            strip_ime_composition_window_flag(LPARAM(flags)),
+            LPARAM(other_flags)
+        );
+        assert_eq!(strip_ime_composition_window_flag(LPARAM(0)), LPARAM(0));
+    }
+
+    #[test]
+    fn only_opening_or_changing_candidates_syncs_the_caret() {
+        for notification in [IMN_OPENCANDIDATE, IMN_CHANGECANDIDATE] {
+            assert!(should_sync_ime_notify(WPARAM(notification as usize)));
+        }
+        for notification in [
+            IMN_CLOSECANDIDATE,
+            IMN_SETCANDIDATEPOS,
+            IMN_SETCOMPOSITIONWINDOW,
+        ] {
+            assert!(!should_sync_ime_notify(WPARAM(notification as usize)));
+        }
+    }
+
+    #[test]
+    fn process_key_is_reserved_for_ime() {
+        assert!(is_ime_process_key(WPARAM(VK_PROCESSKEY.0.into())));
+        for key in [VK_BACK, VK_RETURN, VK_SPACE, VK_LEFT, VK_A] {
+            assert!(!is_ime_process_key(WPARAM(key.0.into())));
+        }
+    }
+
+    #[test]
+    fn result_only_and_empty_messages_clear_marked_text() {
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_RESULTSTR.0 as isize)).collect::<Vec<_>>(),
+            [ImeUpdate::Commit, ImeUpdate::Clear]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_COMPSTR.0 as isize)).collect::<Vec<_>>(),
+            [ImeUpdate::Preedit]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(0)).collect::<Vec<_>>(),
+            [ImeUpdate::Clear]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_COMPATTR.0 as isize)).next(),
+            None
+        );
+    }
+
+    #[test]
+    fn partial_commit_keeps_the_remaining_preedit() {
+        for cursor in [0, GCS_CURSORPOS.0] {
+            let flags = GCS_RESULTSTR.0 | GCS_COMPSTR.0 | cursor;
+            assert_eq!(
+                ImeUpdate::from_flags(LPARAM(flags as isize)).collect::<Vec<_>>(),
+                [ImeUpdate::Commit, ImeUpdate::Preedit]
+            );
+        }
+    }
 }

