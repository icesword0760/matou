+                    let style = div()
+                        .whitespace_nowrap()
+                        .text_ellipsis()
+                        .text_style()
+                        .take();
+                    window.with_text_style(style, |window| {
+                        let mut text = StyledText::new(TITLE);
+                        let (node, mut state) = text.request_layout(None, None, window, cx);
+                        window.compute_layout(node, MAX_CONTENT, cx);
+                        assert_eq!(text.layout().text(), TITLE);
+
+                        let mut bounds = window.layout_bounds(node);
+                        let measured_width =
