+fn parse_ime_composition_string(ctx: HIMC, comp_type: IME_COMPOSITION_STRING) -> Option<String> {
+    unsafe {
+        let byte_len = u32::try_from(ImmGetCompositionStringW(ctx, comp_type, None, 0)).ok()?;
+        if byte_len == 0 {
+            return Some(String::new());
+        }
+        let mut buffer = vec![0u16; byte_len.div_ceil(2) as usize];
+        let copied = usize::try_from(ImmGetCompositionStringW(
+            ctx,
+            comp_type,
+            Some(buffer.as_mut_ptr().cast()),
+            byte_len,
+        ))
+        .ok()?;
+        Some(String::from_utf16_lossy(buffer.get(..copied / 2)?))
+    }
+}
+
+fn retrieve_composition_cursor_position(ctx: HIMC) -> Option<usize> {
+    usize::try_from(unsafe { ImmGetCompositionStringW(ctx, GCS_CURSORPOS, None, 0) }).ok()
+}
+
+#[cfg(test)]
+mod ime_tests {
+    use super::*;
+
+    #[test]
+    fn process_key_is_reserved_for_ime() {
+        assert!(is_ime_process_key(WPARAM(VK_PROCESSKEY.0.into())));
+        for key in [VK_BACK, VK_RETURN, VK_SPACE, VK_LEFT, VK_A] {
+            assert!(!is_ime_process_key(WPARAM(key.0.into())));
+        }
+    }
+
+    #[test]
+    fn result_only_and_empty_messages_clear_marked_text() {
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_RESULTSTR.0 as isize)).collect::<Vec<_>>(),
+            [ImeUpdate::Commit, ImeUpdate::Clear]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_COMPSTR.0 as isize)).collect::<Vec<_>>(),
+            [ImeUpdate::Preedit]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(0)).collect::<Vec<_>>(),
+            [ImeUpdate::Clear]
+        );
+        assert_eq!(
+            ImeUpdate::from_flags(LPARAM(GCS_COMPATTR.0 as isize)).next(),
+            None
+        );
+    }
+
+    #[test]
+    fn partial_commit_keeps_the_remaining_preedit() {
+        for cursor in [0, GCS_CURSORPOS.0] {
+            let flags = GCS_RESULTSTR.0 | GCS_COMPSTR.0 | cursor;
+            assert_eq!(
+                ImeUpdate::from_flags(LPARAM(flags as isize)).collect::<Vec<_>>(),
+                [ImeUpdate::Commit, ImeUpdate::Preedit]
+            );
+        }
+    }
 }

