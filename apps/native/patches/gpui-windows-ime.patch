+    fn assert_ellipsis_at_final_width(width: impl FnOnce(Pixels) -> Pixels + 'static) {
+        let mut cx = TestAppContext::single();
+        let cx = cx.add_empty_window();
+        cx.draw(point(px(0.), px(0.)), MAX_CONTENT, |_, _| {
+            canvas(
