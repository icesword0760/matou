+fn caret_bounds_to_physical_rect(
+    origin_x: f32,
+    origin_y: f32,
+    width: f32,
+    height: f32,
+    scale_factor: f32,
+) -> RECT {
+    let left = (origin_x * scale_factor).round() as i32;
+    let top = (origin_y * scale_factor).round() as i32;
+    RECT {
+        left,
+        top,
+        right: left + (width * scale_factor).round().max(1.0) as i32,
+        bottom: top + (height * scale_factor).round().max(1.0) as i32,
+    }
+}
+
+fn strip_ime_composition_window_flag(lparam: LPARAM) -> LPARAM {
+    LPARAM(lparam.0 & !(ISC_SHOWUICOMPOSITIONWINDOW as isize))
+}
+
+fn should_sync_ime_notify(wparam: WPARAM) -> bool {
+    matches!(wparam.0 as u32, IMN_OPENCANDIDATE | IMN_CHANGECANDIDATE)
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum ImeUpdate {
+    Clear,
+    Commit,
+    Preedit,
+}
+
+impl ImeUpdate {
+    fn from_flags(lparam: LPARAM) -> impl Iterator<Item = Self> {
+        let flags = lparam.0 as u32;
+        let commit = flags & GCS_RESULTSTR.0 != 0;
+        // An IME can commit part of the text and continue composing the rest.
+        let next = if flags & GCS_COMPSTR.0 != 0 {
+            Some(Self::Preedit)
+        } else if commit || flags == 0 {
+            Some(Self::Clear)
         } else {
             None
+        };
+        [commit.then_some(Self::Commit), next].into_iter().flatten()
+    }
+}
+
+struct ImeContext {
+    window: HWND,
+    raw: HIMC,
+}
+
+impl ImeContext {
+    fn acquire(window: HWND) -> Option<Self> {
+        let raw = unsafe { ImmGetContext(window) };
+        if raw.is_invalid() {
+            None
+        } else {
+            Some(Self { window, raw })
         }
     }
