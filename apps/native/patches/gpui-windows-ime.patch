+            canvas(
+                |_, window, cx| {
+                    let style = div()
+                        .whitespace_nowrap()
+                        .text_ellipsis()
+                        .text_style()
+                        .take();
+                    window.with_text_style(style, |window| {
+                        let style = window.text_style();
+                        let runs = vec![
+                            style.to_run(8),
+                            TextRun {
+                                color: rgb(0xff0000).into(),
+                                ..style.to_run(TITLE.len() - 8)
+                            },
+                        ];
+                        let layout = TextLayout::default();
+                        let node = layout.layout(TITLE.into(), Some(runs), window, cx);
+
+                        window.compute_layout(node, MAX_CONTENT, cx);
+                        assert_eq!(layout.text(), TITLE);
+
+                        let narrow = px(62.);
+                        let wider = px(118.);
+                        let definite = |width| {
+                            size(AvailableSpace::Definite(width), AvailableSpace::MaxContent)
+                        };
+                        window.compute_layout(node, definite(narrow), cx);
+                        let narrow_text = assert_ellipsized(&layout, narrow);
+                        window.compute_layout(node, definite(wider), cx);
+                        let wider_text = assert_ellipsized(&layout, wider);
+                        assert!(wider_text.len() > narrow_text.len());
+
+                        window.compute_layout(node, MAX_CONTENT, cx);
+                        assert_eq!(layout.text(), TITLE);
+                        window.compute_layout(node, definite(narrow), cx);
+                        assert_eq!(assert_ellipsized(&layout, narrow), narrow_text);
+                        window.compute_layout(node, definite(px(400.)), cx);
+                        assert_eq!(layout.text(), TITLE);
+                        let state = layout.0.borrow();
+                        let runs = &state.as_ref().unwrap().lines[0].decoration_runs;
+                        assert_eq!(runs.len(), 2);
+                        assert_eq!(runs[0].len, 8);
+                        assert_eq!(runs[1].len as usize, TITLE.len() - 8);
+                    });
+                },
+                |_, (), _, _| {},
+            )
+        });
+    }
