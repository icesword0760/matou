+    fn assert_ellipsized(layout: &TextLayout, width: Pixels) -> String {
+        let text = layout.text();
+        assert!(
+            text.ends_with('…'),
+            "expected an ellipsis at width {width:?}, got {text:?}"
+        );
+        let state = layout.0.borrow();
+        let state = state.as_ref().unwrap();
