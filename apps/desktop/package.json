{
  "name": "@matou/desktop",
  "version": "0.1.8",
  "productName": "码头",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ../../tooling/run-desktop-dev.mjs",
    "build": "electron-vite build",
    "test": "vitest run && vitest run --config vitest.performance.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf out"
  },
  "dependencies": {
    "@matou/contracts": "workspace:*",
    "@matou/domain": "workspace:*",
    "@matou/ui": "workspace:*",
    "@samasante/liquid-glass": "0.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "electron-vite": "5.0.0",
    "jsdom": "^30.0.1"
  },
  "build": {
    "appId": "com.matou.desktop",
    "electronVersion": "43.4.1",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "package-resources/runtime",
        "to": "runtime"
      },
      {
        "from": "build/finder-quick-action/进入码头.workflow",
        "to": "finder-quick-action/进入码头.workflow"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "linux": {
      "target": "dir"
    },
    "win": {
      "target": "dir"
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Matou-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "generic",
        "url": "${env.MATOU_UPDATE_BASE_URL}",
        "channel": "stable"
      }
    ]
  }
}
