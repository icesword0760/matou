{
  "name": "matou",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build:native": "cargo build --manifest-path apps/native/Cargo.toml --release",
    "test:native": "cargo test --manifest-path apps/native/Cargo.toml --offline --locked",
    "check:native-clean-install": "cargo test --manifest-path apps/native/Cargo.toml -p matou-native-runtime --offline --locked --test native_hooks_contract --test foreman_read_contract --test foreman_process_contract --test foreman_mail_contract --test environment_runtime_contract --test mt_context_contract",
    "check:identifiers": "node tooling/project-identifier-policy.mjs",
    "test:identifiers": "node --test tooling/project-identifier-policy.test.mjs",
    "test:tooling": "node --test tooling/project-identifier-policy.test.mjs tooling/install-macos-app.test.mjs tooling/packaging/package-native-mac.test.mjs tooling/packaging/package-native-win.test.mjs tooling/release-native-mac.test.mjs tooling/release-native-win.test.mjs tooling/model-router/prepare.test.mjs",
    "test:accounts": "uv run --frozen --project tooling/claude-accounts python -m unittest discover -s tooling/claude-accounts -p 'test_*.py'",
    "test": "pnpm check:identifiers && pnpm test:tooling && pnpm test:accounts && pnpm test:native",
    "install:mac": "node tooling/install-macos-app.mjs",
    "package:mac": "node tooling/release-native-mac.mjs",
    "package:win": "node tooling/release-native-win.mjs",
    "accounts:setup": "uv sync --project tooling/claude-accounts --frozen",
    "accounts:build": "node tooling/claude-accounts/build.mjs",
    "router:prepare": "node tooling/model-router/prepare.mjs",
    "router:build": "node tooling/model-router/build-patched.mjs --package"
  }
}
